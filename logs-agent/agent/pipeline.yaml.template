# Vector pipeline TEMPLATE: Postgres csvlog -> human-readable console + OTLP/HTTP
#
# Consumed by `slon` at startup: it substitutes the placeholder values
# (INSTANCE_UUID, OTLP_ENDPOINT — see the body of the file), conditionally
# includes the remote sink (omitted entirely when the user has not opted
# into log shipment), and writes the resulting yaml to
# /etc/vector/vector.yaml.  The placeholders use Vector-native env-var
# interpolation syntax, so a passthrough mode (slon sets INSTANCE_UUID and
# OTLP_ENDPOINT in the agent's environment, Vector interpolates at config
# load) works from this template equivalently — that is what the e2e
# verify script does.
#
# Note: Vector applies env-var interpolation textually across the whole
# YAML *including comments*, so do not write the literal placeholder
# syntax in comments — Vector will try to resolve it as a real variable
# and fail config load if absent.
#
# Tested against the curated agent build (//agent:image), features:
#   sources-file,transforms-remap,sinks-console,sinks-opentelemetry
#
# Single-tenant by construction: one agent per slon, one slon per
# Postgres instance. instance.uuid is a slon-level constant — there is
# no per-event tag-transform clone-pair pattern.
#
# Storage layout (set up by slon in the slon container; sizing rationale
# in the subsystem DESIGN.md "Log buffering" subsection):
#   /var/log/postgresql   tmpfs, 256 MiB cap. csvlog working set —
#                         24 hour-of-day slots × 10MB, cycled and
#                         truncated by log_truncate_on_rotation.
#   /var/lib/vector       persistent volume. Vector's data_dir holds
#                         file-source checkpoint state and the OTLP
#                         sink's disk buffer (outage durability).
#
# Postgres-side knobs that this pipeline assumes (slon applies them at
# PG start; full table with rationale and postgresqlco.nf links in the
# subsystem DESIGN.md): log_destination=csvlog, logging_collector=on,
# log_directory=(the tmpfs path below), log_filename=postgresql-%H
# (PG appends `.csv`), log_rotation_size=10MB, log_rotation_age=1h,
# log_truncate_on_rotation=on, log_file_mode=0644.

data_dir: /var/lib/vector

sources:
  pg_csvlog:
    type: file
    include:
      - /var/log/postgresql/postgresql-*.csv
    read_from: end
    multiline:
      # PG17 csvlog records begin with a UTC timestamp like
      # "2026-04-30 12:34:56.789 UTC,". Aggregate continuation lines
      # (embedded newlines inside quoted message/query fields) into a
      # single event before parse_csv runs.
      start_pattern: '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+ \w+,'
      mode: halt_before
      condition_pattern: '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+ \w+,'
      timeout_ms: 1000
    # Slot-cycle handling: with log_truncate_on_rotation=on, PG
    # truncates the slot file in-place when reused. Vector's default
    # fingerprinting (first-bytes content hash) detects the change and
    # re-tails the slot from the start — no extra config needed.

transforms:
  # Stamp every record with the slon's instance UUID. slon substitutes
  # the literal at template-fill time, or sets INSTANCE_UUID in the
  # agent's env (Vector interpolates at config load either way).
  tag_instance:
    type: remap
    inputs: [pg_csvlog]
    source: |
      .instance_uuid = "${INSTANCE_UUID}"

  # Stage 1: CSV parse. PG17+ csvlog has 26 columns, every one populated
  # (empties land as ""). A different count = format change we should
  # surface, not silently mis-parse.
  pg_parse:
    type: remap
    inputs: [tag_instance]
    source: |
      raw = string!(.message)
      cols, err = parse_csv(raw)
      if err != null {
        .parse_error = "csv parse: " + err
      } else if length(cols) != 26 {
        .parse_error = "unexpected csvlog column count: " + to_string(length(cols)) + " (expected 26 for PG17+)"
      } else {
        .log_time               = cols[0]
        .user_name              = cols[1]
        .database_name          = cols[2]
        .process_id             = cols[3]
        .connection_from        = cols[4]
        .session_id             = cols[5]
        .session_line_num       = cols[6]
        .command_tag            = cols[7]
        .session_start_time     = cols[8]
        .virtual_transaction_id = cols[9]
        .transaction_id         = cols[10]
        .severity               = cols[11]
        .sql_state_code         = cols[12]
        .pg_message             = cols[13]
        .detail                 = cols[14]
        .hint                   = cols[15]
        .internal_query         = cols[16]
        .internal_query_pos     = cols[17]
        .context                = cols[18]
        .query                  = cols[19]
        .query_pos              = cols[20]
        .location               = cols[21]
        .application_name       = cols[22]
        .backend_type           = cols[23]
        .leader_pid             = cols[24]
        .query_id               = cols[25]

        # Postgres-stderr-like one-liner for the console sink.
        .message = .log_time + " [" + .process_id + "] " + .severity + ": " + .pg_message
      }

  # Stage 2: build a standards-compliant OTLP `ExportLogsServiceRequest`
  # envelope. Vector's `codec: otlp` keys off the top-level `resourceLogs`
  # field; this transform replaces the event with that envelope.
  #
  # Attribute namespace: OTel-conventional `db.*` keys where the spec has
  # an equivalent, `pg.*` for Postgres-specific fields without one.
  pg_to_otlp:
    type: remap
    inputs: [pg_parse]
    source: |
      parsed_ts = parse_timestamp(string!(.log_time), "%Y-%m-%d %H:%M:%S%.f %Z") ?? now()
      ts_ns = to_unix_timestamp(parsed_ts, unit: "nanoseconds")

      # PG severity -> OTLP SeverityNumber.
      # https://opentelemetry.io/docs/specs/otel/logs/data-model/#field-severitynumber
      sev_text = string!(.severity)
      sev_num = if sev_text == "DEBUG1" || sev_text == "DEBUG2" || sev_text == "DEBUG3" || sev_text == "DEBUG4" || sev_text == "DEBUG5" {
        5    # DEBUG
      } else if sev_text == "INFO" || sev_text == "LOG" {
        9    # INFO
      } else if sev_text == "NOTICE" {
        10   # INFO2
      } else if sev_text == "WARNING" {
        13   # WARN
      } else if sev_text == "ERROR" {
        17   # ERROR
      } else if sev_text == "FATAL" || sev_text == "PANIC" {
        21   # FATAL
      } else {
        0    # UNSPECIFIED
      }

      # All 26 PG17 csvlog fields as per-record attributes. Keys are
      # unconditional — empty strings are valid and signal "field absent
      # in this record".
      attrs = [
        {"key": "db.user",              "value": {"stringValue": string!(.user_name)}},
        {"key": "db.process_id",        "value": {"stringValue": string!(.process_id)}},
        {"key": "client.address",       "value": {"stringValue": string!(.connection_from)}},
        {"key": "db.session_id",        "value": {"stringValue": string!(.session_id)}},
        {"key": "pg.session_line_num",  "value": {"stringValue": string!(.session_line_num)}},
        {"key": "db.operation",         "value": {"stringValue": string!(.command_tag)}},
        {"key": "pg.session_start_time","value": {"stringValue": string!(.session_start_time)}},
        {"key": "pg.virtual_xid",       "value": {"stringValue": string!(.virtual_transaction_id)}},
        {"key": "db.transaction_id",    "value": {"stringValue": string!(.transaction_id)}},
        {"key": "db.sqlstate",          "value": {"stringValue": string!(.sql_state_code)}},
        {"key": "pg.detail",            "value": {"stringValue": string!(.detail)}},
        {"key": "pg.hint",              "value": {"stringValue": string!(.hint)}},
        {"key": "pg.internal_query",    "value": {"stringValue": string!(.internal_query)}},
        {"key": "pg.internal_query_pos","value": {"stringValue": string!(.internal_query_pos)}},
        {"key": "pg.context",           "value": {"stringValue": string!(.context)}},
        {"key": "db.statement",         "value": {"stringValue": string!(.query)}},
        {"key": "pg.query_pos",         "value": {"stringValue": string!(.query_pos)}},
        {"key": "pg.location",          "value": {"stringValue": string!(.location)}},
        {"key": "db.application",       "value": {"stringValue": string!(.application_name)}},
        {"key": "db.backend_type",      "value": {"stringValue": string!(.backend_type)}},
        {"key": "pg.leader_pid",        "value": {"stringValue": string!(.leader_pid)}},
        {"key": "pg.query_id",          "value": {"stringValue": string!(.query_id)}}
      ]

      # Replace the event with the OTLP envelope. instance.uuid is at
      # resource scope (one Postgres instance per logical batch); the
      # database name is also at resource scope (per OTel db.* spec
      # semantics — different events from different DBs ship as separate
      # resourceLogs[] entries which proto3-concatenate cleanly into a
      # single ExportLogsServiceRequest).
      . = {
        "resourceLogs": [{
          "resource": {
            "attributes": [
              {"key": "service.name",  "value": {"stringValue": "postgresql"}},
              {"key": "db.system",     "value": {"stringValue": "postgresql"}},
              {"key": "db.namespace",  "value": {"stringValue": string!(.database_name)}},
              {"key": "instance.uuid", "value": {"stringValue": string!(.instance_uuid)}}
            ]
          },
          "scopeLogs": [{
            "scope": {"name": "postgresql.csvlog"},
            "logRecords": [{
              "timeUnixNano":         to_string(ts_ns),
              "observedTimeUnixNano": to_string(ts_ns),
              "severityNumber":       sev_num,
              "severityText":         sev_text,
              "body":                 {"stringValue": string!(.pg_message)},
              "attributes":           attrs
            }]
          }]
        }]
      }

sinks:
  # Always-on local visibility. slon keeps this sink in every generated
  # config, regardless of the remote-shipment opt-in.
  console_text:
    type: console
    inputs: [pg_parse]      # human-readable text path (NOT the OTLP-shaped event)
    encoding:
      codec: text

  # Conditional: slon includes this sink iff the user has opted into
  # remote log shipment; omitted entirely otherwise.
  # The `uri` is the user-repointable knob — any OTLP/HTTP-compatible
  # collector (otelcol, Grafana Agent, Datadog Agent, Honeycomb, …)
  # accepts this same wire format unmodified, so customers who want logs
  # delivered to their own observability stack just receive a different
  # OTLP_ENDPOINT value.
  #
  # Disk buffer on the persistent volume (Vector's data_dir): rides out
  # a receiver outage without dropping events; backpressures the file
  # source when full. max_size is the operator-visible durability
  # tradeoff — see the subsystem DESIGN.md "Log buffering" subsection.
  otlp_remote:
    type: opentelemetry
    inputs: [pg_to_otlp]    # OTLP-shaped events only
    buffer:
      type: disk
      # 256 MiB working storage. The literal is 32 bytes above 256*2^20:
      # Vector reserves 32 bytes of internal overhead and rejects any
      # max_size below that minimum, so the smallest valid "256 MiB-class"
      # value is 268435488. Tunable per deployment.
      max_size: 268435488
      when_full: block
    protocol:
      type: http
      uri: ${OTLP_ENDPOINT}
      method: post
      encoding:
        codec: otlp         # emits proper OTLP protobuf bodies
      framing:
        method: bytes       # one event = one binary body (required for protobuf)
      request:
        headers:
          content-type: application/x-protobuf
      # auth, tls, batch, request retry policy go here in production
