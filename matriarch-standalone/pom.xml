<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.stackgres</groupId>
    <artifactId>stackgres-parent</artifactId>
    <version>1.20.0-SNAPSHOT</version>
    <relativePath>../stackgres-k8s/src/pom.xml</relativePath>
  </parent>

  <artifactId>stackgres-matriarch-standalone</artifactId>
  <packaging>jar</packaging>

  <!-- Standalone (bare-metal) Matriarch control panel + slon/slony bridge, over api.v1 gRPC.
       Proto stubs come from stackgres-proto; the core from stackgres-matriarch. -->
  <dependencies>
    <dependency>
      <groupId>io.stackgres</groupId>
      <artifactId>stackgres-matriarch</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.stackgres</groupId>
      <artifactId>stackgres-proto</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>
    <!-- Client transport for the outbound cloud uplink channel (io.stackgres.matriarch.quarkus.cloud).
         quarkus-grpc ships the server transport; the dial-out channel needs Netty. Compile scope
         because CloudUplinkClient references NettyChannelBuilder/GrpcSslContexts directly to support
         a self-signed (insecure-tls) cloud endpoint. Unshaded grpc-netty (not grpc-netty-shaded) so it
         shares Quarkus' own io.netty and its native-image config — the shaded copy breaks the native
         build (JdkNpnApplicationProtocolNegotiator init-at-build-time -> missing Jetty NPN). -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
    <!-- Jakarta JSON-P (used by DocirVersionCatalog via jakarta.json.Json). The quarkus-jsonp
         extension bundles Parsson AND registers its JsonProvider for native image — a bare
         jakarta.json-api + parsson leaves the ServiceLoader lookup unregistered, so the native
         binary fails at runtime with "Provider org.eclipse.parsson.JsonProviderImpl not found". -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jsonp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <!-- Activate with -Pnative. Quarkus native build; emits target/matriarch-runner, which
           cli/bundle/build.sh renames to `matriarch` for bundling. -->
      <properties>
        <quarkus.native.enabled>true</quarkus.native.enabled>
        <quarkus.package.output-name>matriarch</quarkus.package.output-name>
      </properties>
    </profile>
  </profiles>

</project>
