# minio stand-in backed by SeaweedFS (see resources/seaweedfs.yaml). It keeps the
# names the tests rely on: the Service and the Secret are both named after
# MINIO_NAME, the Service serves S3 on port 9000, the Secret holds the
# credentials under the accesskey and secretkey keys, and the bucket named
# after BUCKET_NAME is already created once install_minio returns. With --tls
# S3 is served over HTTPS on that same port, using a certificate stored in the
# MINIO_NAME-certs TLS Secret.

is_minio_installed() {
  MINIO_NAME="${MINIO_NAME:-$CLUSTER_NAME-minio}"
  MINIO_NAMESPACE="${MINIO_NAMESPACE:-$CLUSTER_NAMESPACE}"
  kubectl get deployment --namespace "$MINIO_NAMESPACE" "$MINIO_NAME" > /dev/null 2>&1
}

uninstall_minio() {
  MINIO_NAME="${MINIO_NAME:-$CLUSTER_NAME-minio}"
  MINIO_NAMESPACE="${MINIO_NAMESPACE:-$CLUSTER_NAMESPACE}"
  kubectl delete --namespace "$MINIO_NAMESPACE" deployment,service,job,secret,pvc \
    -l "app.kubernetes.io/instance=$MINIO_NAME" --ignore-not-found
  kubectl delete secret --namespace "$MINIO_NAMESPACE" "$MINIO_NAME"-certs --ignore-not-found
}

install_minio() {
  MINIO_NAME="${MINIO_NAME:-$CLUSTER_NAME-minio}"
  BUCKET_NAME="${BUCKET_NAME:-stackgres}"
  MINIO_NAMESPACE="${MINIO_NAMESPACE:-$CLUSTER_NAMESPACE}"
  local MINIO_TLS=false
  if [ "$1" = --tls ]
  then
    MINIO_TLS=true
  fi
  kubectl create namespace "$MINIO_NAMESPACE" || true

  if [ "$MINIO_TLS" = true ]
  then
    cat << EOF > "$LOG_PATH/minio-cert.config"
[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_req
prompt = no

[req_distinguished_name]
C = US
ST = VA
L = Somewhere
O = MyOrg
OU = MyOU
CN = MyServerName

[v3_req]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = ${MINIO_NAME}.${MINIO_NAMESPACE}
DNS.2 = ${MINIO_NAME}
EOF

    openssl genrsa -out "$LOG_PATH/minio-cert.key" 2048
    openssl req -new -x509 -nodes \
      -keyout "$LOG_PATH/minio-cert.key" \
      -out "$LOG_PATH/minio-cert.crt" \
      -config "$LOG_PATH/minio-cert.config" 
    kubectl create secret tls -n "$MINIO_NAMESPACE" "$MINIO_NAME"-certs \
      --cert="$LOG_PATH/minio-cert.crt" \
      --key="$LOG_PATH/minio-cert.key"
  fi

  MINIO_ACCESS_KEY="$(openssl rand -hex 10)"
  MINIO_SECRET_KEY="$(openssl rand -hex 20)"
  sed \
    -e "s/\${MINIO_NAME}/$MINIO_NAME/g" \
    -e "s/\${BUCKET_NAME}/$BUCKET_NAME/g" \
    -e "s/\${MINIO_ACCESS_KEY}/$MINIO_ACCESS_KEY/g" \
    -e "s/\${MINIO_SECRET_KEY}/$MINIO_SECRET_KEY/g" \
    -e "s/\${E2E_TIMEOUT}/$E2E_TIMEOUT/g" \
    "$E2E_PATH/resources/seaweedfs.yaml" \
    | yq "
      if .kind == \"Deployment\" and $MINIO_TLS
      then
        .spec.template.spec.containers[0].args += [
          \"-s3.cert.file=/etc/seaweedfs/certs/tls.crt\",
          \"-s3.key.file=/etc/seaweedfs/certs/tls.key\"
          ]
        | .spec.template.spec.containers[0].volumeMounts += [
          { name: \"certs\", mountPath: \"/etc/seaweedfs/certs\", readOnly: true }
          ]
        | .spec.template.spec.volumes += [
          { name: \"certs\", secret: { secretName: \"$MINIO_NAME-certs\" } }
          ]
      else
        .
      end
      | if .kind == \"Deployment\" and \"$E2E_ENV\" == \"kind\"
      then
        .spec.template.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution
          .nodeSelectorTerms = [{ matchExpressions: [{
            key: \"kubernetes.io/hostname\",
            operator: \"In\",
            values: [ \"${KIND_NAME}-worker\", \"${KIND_NAME}-control-plane\" ]
            }] }]
      else
        .
      end
      " \
    > "$LOG_PATH/minio.yaml"
  kubectl apply --namespace "$MINIO_NAMESPACE" -f "$LOG_PATH/minio.yaml"

  kubectl wait --timeout="$((E2E_TIMEOUT * 2))s" --namespace "$MINIO_NAMESPACE" \
    job/"$MINIO_NAME"-make-bucket --for=condition=Complete
}
