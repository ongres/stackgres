#!/bin/sh

# kind selects the engine to drive through KIND_EXPERIMENTAL_PROVIDER and
# executes it by name, so a CONTAINER_ENGINE carrying arguments (like
# `podman --remote`) can not be used here. See check_kind_podman_support for the
# requirements podman has to satisfy to run kind.
if container_engine_is_podman
then
  export KIND_EXPERIMENTAL_PROVIDER=podman
  # A kind node is a container that runs its own kubelet and its own containerd,
  # so it needs the opposite of what the build jobs configure: its own UTS
  # namespace, that kind names, and cgroups of its own for the kubelet to manage.
  # The CI image ships that configuration as containers-kind.conf, see
  # stackgres-k8s/ci/build/Dockerfile-ci. A podman 4 client sends its own
  # defaults to the service, so this decides the namespaces of the nodes even
  # when the engine is remote. Honour a value already set, which is what lets
  # stackgres-k8s/ci/runner/kind-probe.sh and a developer pick another one.
  if [ -z "$CONTAINERS_CONF" ] && [ -r /etc/containers/containers-kind.conf ]
  then
    export CONTAINERS_CONF=/etc/containers/containers-kind.conf
  fi
fi

KIND_NAME="${KIND_NAME:-kind}"
KIND_NODES="${KIND_NODES:-1}"
KIND_LOCK_PATH="${KIND_LOCK_PATH:-$TARGET_PATH/kind-lock}"
KIND_CONTAINERD_CACHE_PATH="${K8S_CACHE_HOST_PATH:-$KIND_CONTAINERD_CACHE_PATH}"
KIND_CONTAINERD_CACHE_RESET="${K8S_CACHE_RESET:-$KIND_CONTAINERD_CACHE_RESET}"
KIND_LOG_HOST_PATH="${KIND_LOG_HOST_PATH:-$TARGET_PATH/kind-logs}"
KIND_LOG_RESOURCES_POLICY_HOST_PATH="${KIND_LOG_RESOURCES_POLICY_HOST_PATH:-$TARGET_PATH/kind-apiserver-audit-policy}"
KIND_EXPANDABLE_STORAGE_CLASSNAME="${EXPANDABLE_STORAGE_CLASSNAME:-expandable-sc}"
K8S_IP_FAMILY="${K8S_IP_FAMILY:-ipv4}"
KIND_0_15_0="${KIND_0_15_0:-kind-0.15.0}"
KIND_0_20_0="${KIND_0_20_0:-kind-0.20.0}"
KIND_0_23_0="${KIND_0_23_0:-kind-0.23.0}"
KIND_0_25_0="${KIND_0_25_0:-kind-0.25.0}"
KIND_0_26_0="${KIND_0_26_0:-kind-0.26.0}"
KIND_0_29_0="${KIND_0_29_0:-kind-0.29.0}"
KIND_0_31_0="${KIND_0_31_0:-kind-0.31.0}"
KIND_0_32_0="${KIND_0_32_0:-kind-0.32.0}"

check_kind_podman_support() {
  container_engine_is_podman || return 0
  if [ "$CONTAINER_ENGINE" != "${CONTAINER_ENGINE%% *}" ]
  then
    echo "kind executes the container engine by name, so CONTAINER_ENGINE can not have arguments (is '$CONTAINER_ENGINE')"
    return 1
  fi
  if [ "$KIND" = "$KIND_0_15_0" ]
  then
    echo "To run kind with podman kind v0.20.0 is required, but Kubernetes $K8S_VERSION requires kind v0.15.0"
    return 1
  fi
  # What follows describes the machine the containers run on, which is the one
  # answering the socket when the engine is remote. There the service is a
  # rootful podman, so netavark builds the bridge and the veth pairs itself and
  # never opens a tap device, and the cgroups that matter are its own.
  container_engine_is_remote && return 0
  if [ ! -e /dev/net/tun ]
  then
    echo "kind creates its own bridge network and the network backend of podman requires /dev/net/tun to set it up"
    return 1
  fi
  # podman is rootless when it is not invoked by the root, and only then it
  # needs the cgroups v2 to be able to delegate them to the kind nodes.
  if [ "$(id -u)" != 0 ] && [ "$(stat -f -c %T /sys/fs/cgroup)" != cgroup2fs ]
  then
    echo "A rootless podman requires the cgroups v2 in order to run kind"
    return 1
  fi
}

# kind refuses to create a cluster with a rootless podman unless the cgroup
# controllers cpu, memory and pids are available, and it asks podman for them, so
# what decides is the cgroup this script runs in. The systemd user manager only
# delegates memory and pids to the scope of an application by default, so a shell
# started by a desktop session fails while one started by a login session, that
# lives directly under the slice of the user, works.
check_kind_podman_cgroup_delegation() {
  container_engine_is_podman || return 0
  # The delegation is asked of the cgroup this shell runs in, that with a remote
  # engine is not the one the nodes are created under.
  container_engine_is_remote && return 0
  local ENGINE_INFO
  ENGINE_INFO="$($CONTAINER_ENGINE info \
    --format '{{ .Host.Security.Rootless }} {{ .Host.CgroupControllers }}')"
  [ "${ENGINE_INFO%% *}" = true ] || return 0
  local CGROUP_CONTROLLERS
  CGROUP_CONTROLLERS=" $(printf %s "${ENGINE_INFO#* }" | tr -d '[]') "
  local CGROUP_CONTROLLER
  for CGROUP_CONTROLLER in cpu memory pids
  do
    case "$CGROUP_CONTROLLERS" in
      (*" $CGROUP_CONTROLLER "*) ;;
      (*)
        cat << EOF
The cgroup controller $CGROUP_CONTROLLER is not delegated to $(cut -d : -f 3 /proc/self/cgroup),
the cgroup this shell runs in, and kind requires cpu, memory and pids to create
a cluster with a rootless podman.

Either run the e2e test in a scope that asks for the delegation:

  systemd-run --user --scope -p Delegate=yes -- <command>

or delegate them to every session, which requires the root and to log in again:

  sudo mkdir -p /etc/systemd/system/user@.service.d
  printf '[Service]\nDelegate=cpu cpuset io memory pids\n' \\
    | sudo tee /etc/systemd/system/user@.service.d/delegate.conf
  sudo systemctl daemon-reload
EOF
        return 1
        ;;
    esac
  done
}

# podman does not have .Server.Arch, the platform is only exposed by the info.
kind_engine_platform() {
  if container_engine_is_podman
  then
    $CONTAINER_ENGINE info --format '{{ .Version.OsArch }}'
  else
    docker version --format '{{ .Server.Os }}/{{ .Server.Arch }}'
  fi
}

# The filesystem backing the storage of the engine is what determines the
# snapshotter the containerd of the kind nodes has to be configured with. docker
# reports it in the info, podman in the status of its graph driver.
kind_backing_filesystem() {
  if container_engine_is_podman
  then
    $CONTAINER_ENGINE info --format '{{ index .Store.GraphStatus "Backing Filesystem" }}' 2> /dev/null
  else
    docker system info 2> /dev/null | grep 'Backing Filesystem:' \
      | cut -d : -f 2 | tr -d '[:space:]'
  fi
}

# The following operations are performed on the filesystem of the host running
# the engine, that is not the host running this script when the engine is a
# remote or a docker in docker daemon. podman is daemonless and always runs on
# this same host, so perform them directly. This also avoids the rootless trap
# where the root of the container is mapped to the invoking user, that makes
# `-u 0` write with an unexpected ownership.
kind_host_mkdir() {
  if container_engine_is_podman
  then
    mkdir -p "$1"
    # A rootless podman maps the invoking user to the root of a container and
    # leaves every other owner unmapped, so a path belonging to anyone else can
    # not even be chmod-ed from a container. The containerd of a kind node does
    # exactly that to its root directory as it starts, and the node then dies
    # with `chmod /containerd-cache: operation not permitted`. Being writable is
    # not enough, the path has to belong to the user. A remote service is a
    # rootful podman, which maps nothing and can chmod whatever it is given.
    if ! container_engine_is_remote \
      && [ "$(id -u)" != 0 ] && [ "$(stat -c %u "$1")" != "$(id -u)" ]
    then
      cat << EOF
$1 belongs to $(stat -c %U "$1"), but a rootless podman can only map $(id -un)
into a container, so the kind nodes would not be able to use it. Give it to
$(id -un), it is only a cache:

  sudo chown -R $(id -u):$(id -g) '$1'
EOF
      return 1
    fi
  else
    docker run --rm -u 0 -v "/:/source" docker.io/library/alpine \
      mkdir -p "/source/$1"
    docker run --rm -u 0 -v "/:/source" docker.io/library/alpine \
      chmod a+rwx "/source/$1"
  fi
}

kind_host_write() {
  if container_engine_is_podman
  then
    cat > "$1"
  else
    docker run --rm -i -u 0 -v "${1%/*}:/source" docker.io/library/alpine \
      sh -c "cat > '/source/${1##*/}'"
  fi
}

kind_host_reset_dir() {
  if container_engine_is_remote
  then
    # The nodes wrote into the cache as the root of a rootful service, so only
    # that same root can remove what they left.
    $CONTAINER_ENGINE run --rm -u 0 -v "$1:/target" docker.io/library/alpine \
      sh -c 'rm -rf /target/*'
  elif container_engine_is_podman
  then
    if [ "$(id -u)" != 0 ]
    then
      # The cache holds files belonging to the subordinate ids the containers of
      # the nodes were mapped to, that the user can not remove on its own.
      $CONTAINER_ENGINE unshare rm -rf "${1:?}"/*
    else
      rm -rf "${1:?}"/*
    fi
  else
    docker run --rm -v "$1:/target" docker.io/library/alpine \
      sh -c 'rm -rf /target/*'
  fi
}

# The digest of the image a node has to be created from. It is what identifies
# the image a node was created from across engines: docker keeps the whole
# reference kind was invoked with, while podman normalizes it to the repository
# and the digest, dropping the tag.
kind_node_image_digest() {
  local KIND_IMAGE
  KIND_IMAGE="$(get_kind_image "$1")"
  printf %s "${KIND_IMAGE#*@}"
}

# The id of an image of the storage of the engine, in the form the CRI of the
# kind nodes reports it. docker prefixes it with the algorithm, podman does not.
kind_local_image_id() {
  local IMAGE_ID
  IMAGE_ID="$( ($CONTAINER_ENGINE inspect --format '{{ .ID }}' "$1" 2>/dev/null || printf unknown) | grep -v '^$')"
  case "$IMAGE_ID" in
    (unknown|sha256:*) printf %s "$IMAGE_ID" ;;
    (*) printf 'sha256:%s' "$IMAGE_ID" ;;
  esac
}

# The IPv4 subnet of the network kind creates for its nodes, used to carve out
# the address pool of metallb. docker and podman describe a network with an
# unrelated schema, and the network kind creates with podman is dual stack with
# the IPv6 subnet listed first, so the IPv4 one has to be selected explicitly.
kind_network_ipv4_subnet() {
  if container_engine_is_podman
  then
    $CONTAINER_ENGINE network inspect kind \
      | jq -r 'first(.[].subnets[].subnet | select(contains(":") | not))'
  else
    docker network inspect -f json kind \
      | jq -r 'first(.[].IPAM.Config[].Subnet | select(contains(":") | not))'
  fi
}

check_kind_version() {
  if [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -ge "$(echo "1.33" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    KIND="$KIND_0_32_0"
    if ! "$KIND" version | grep -q -F 'kind v0.32.0 '
    then
      echo "To run Kubernetes 1.33+ kind v0.32.0 is required"
      return 1
    fi
  elif [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -ge "$(echo "1.31" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    KIND="$KIND_0_31_0"
    if ! "$KIND" version | grep -q -F 'kind v0.31.0 '
    then
      echo "To run Kubernetes 1.31+ kind v0.31.0 is required"
      return 1
    fi
  elif [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -ge "$(echo "1.30" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    KIND="$KIND_0_29_0"
    if ! "$KIND" version | grep -q -F 'kind v0.29.0 '
    then
      echo "To run Kubernetes 1.30+ kind v0.29.0 is required"
      return 1
    fi
  elif [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -ge "$(echo "1.29" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    KIND="$KIND_0_26_0"
    if ! "$KIND" version | grep -q -F 'kind v0.26.0 '
    then
      echo "To run Kubernetes 1.29+ kind v0.26.0 is required"
      return 1
    fi
  elif [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -ge "$(echo "1.26" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    KIND="$KIND_0_25_0"
    if ! "$KIND" version | grep -q -F 'kind v0.25.0 '
    then
      echo "To run Kubernetes 1.26+ kind v0.25.0 is required"
      return 1
    fi
  elif [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -ge "$(echo "1.25" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    KIND="$KIND_0_23_0"
    if ! "$KIND" version | grep -q -F 'kind v0.23.0 '
    then
      echo "To run Kubernetes 1.25+ kind v0.23.0 is required"
      return 1
    fi
  elif [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -ge "$(echo "1.21" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    KIND="$KIND_0_20_0"
    if ! "$KIND" version | grep -q -F 'kind v0.20.0 '
    then
      echo "To run Kubernetes 1.21+ kind v0.20.0 is required"
      return 1
    fi
  else
    KIND="$KIND_0_15_0"
    if ! "$KIND" version | grep -q -F 'kind v0.15.0 '
    then
      echo "To run Kubernetes 1.20- kind v0.15.0 is required"
      return 1
    fi
  fi

  check_kind_podman_support
}

get_k8s_env_version() {
  echo "Kind version $("$KIND" version | cut -d ' ' -f 2)"
  echo
}

update_k8s_config() {
  check_kind_version

  mkdir -p "$HOME/.kube"
  if [ "$K8S_FROM_DIND" = true ]
  then
    # Put the container this runs in on the network of the nodes, so that it can
    # reach them. Only the engine that created that container can name it, and
    # none of the lookups finds one otherwise: there is no `1:name=` line in the
    # cgroups v2, and /etc/hostname is the name of a machine rather than of a
    # container. Not finding one is not an error, it means there is nothing to
    # connect: either this is not running in a container at all, or it is one
    # the engine did not create, like a container of the pod a job runs in, and
    # a podman serving the socket to it shares the network namespace of that pod
    # and has already put the bridge of the nodes on this side. Only using the
    # empty name is an error, `inspect ''` fails with `name or ID cannot be
    # empty`.
    if $CONTAINER_ENGINE network ls --format '{{ .Name }}' | grep -q '^kind$'
    then
      local CONTAINER_NAME
      CONTAINER_NAME="$(cat /proc/self/cgroup | grep '^1:name' | cut -d / -f 3)"
      CONTAINER_NAME="${CONTAINER_NAME:-$($CONTAINER_ENGINE ps --filter name="^$(cat /etc/hostname)" --format '{{.Names}}')}"
      CONTAINER_NAME="${CONTAINER_NAME:-$($CONTAINER_ENGINE ps --filter id="$(cat /etc/hostname)" --format '{{.ID}}')}"
      if [ -n "$CONTAINER_NAME" ]
      then
        # shellcheck disable=SC2016
        $CONTAINER_ENGINE inspect "$CONTAINER_NAME" \
          -f '{{ range $key,$value := .NetworkSettings.Networks }}{{ printf "%s\n" $key }}{{ end }}' \
          | grep -q '^kind$' \
          || $CONTAINER_ENGINE network connect kind "$CONTAINER_NAME"
      fi
    fi
    local KIND_CONTROL_PLANE_IP
    KIND_CONTROL_PLANE_IP="$($CONTAINER_ENGINE inspect "$KIND_NAME-control-plane" \
      -f '{{ .NetworkSettings.Networks.kind.IPAddress }}')"
    "$KIND" get kubeconfig --name "$KIND_NAME" --internal \
      | sed "s/$KIND_NAME-control-plane/$KIND_CONTROL_PLANE_IP/" \
      > "$HOME/.kube/config-$KIND_NAME"
  else
    "$KIND" get kubeconfig --name "$KIND_NAME" \
      > "$HOME/.kube/config-$KIND_NAME"
  fi

  (
  export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"
  if [ -s "$KUBECONFIG" ]
  then
    KUBECONFIG="$HOME/.kube/config-$KIND_NAME":"$KUBECONFIG" \
      kubectl config view --raw > "$HOME/.kube/config-merged"
    mv "$HOME/.kube/config-merged" "$KUBECONFIG"
  else
    mv "$HOME/.kube/config-$KIND_NAME" "$KUBECONFIG"
  fi
  chmod 700 "$KUBECONFIG"
  )

  chmod 700 "$KUBECONFIG"
  # fix for Unable to connect to the server: x509: certificate is valid for <ips>, not <ip>
  kubectl config set "clusters.kind-$KIND_NAME.insecure-skip-tls-verify" --set-raw-bytes true
  kubectl config unset "clusters.kind-$KIND_NAME.certificate-authority-data"

  screen -ls 2>/dev/null | grep '\.kind-tag-import-images' \
    | tr '[:space:]' ' ' | cut -d ' ' -f 2 | cut -d . -f 1 \
    | xargs -r -I % kill % || true
  E2E_ENV=kind screen -dmS kind-tag-import-images -L -Logfile "$HOME/.kind-tag-import-images.log" "$SHELL" stackgres-k8s/e2e/e2e properly_tag_not_found_import_images
  if [ "$K8S_IP_FAMILY" = ipv6 ]
  then
    screen -ls 2>/dev/null | grep '\.kind-ipv6-dns-socat' \
      | tr '[:space:]' ' ' | cut -d ' ' -f 2 | cut -d . -f 1 \
      | xargs -r -I % kill %
    screen -dmS kind-ipv6-dns-socat -L -Logfile "$HOME/.crc/kind-ipv6-dns-socat.log" socat UDP6-RECVFROM:5300,fork UDP4-SENDTO:127.0.0.53:53
  fi
}

properly_tag_not_found_import_images() {
  echo "Looking for import-* images to tag properly"
  event_watch  --follow \
    | stdbuf -o0 grep '\simage "\(.*library/import-[^@]\+@sha256:[^"]\+\)": not found' \
    | stdbuf -o0 sed 's#^.*\simage "\(.*library/import-[^@]\+@sha256:[^"]\+\)": not found.*$#\1#' \
    | (
      while read IMAGE_NAME
      do
        echo "Detected import-* image $IMAGE_NAME to tag properly into k8s env $E2E_ENV"
        tag_image_k8s "${IMAGE_NAME#*library/}" "$IMAGE_NAME"
      done
      )
}

reuse_k8s() {
  check_kind_version
  check_kind_image_exists

  try_function update_k8s_config

  if ! "$KIND" get clusters | grep -q "^$KIND_NAME$" \
      || ! $CONTAINER_ENGINE inspect "$KIND_NAME-control-plane" -f '{{ .State.Status }}' \
        | grep -q -F 'running' \
      || ! $CONTAINER_ENGINE inspect "$KIND_NAME-control-plane" -f '{{ .Config.Image }}' \
        | grep -q -F "$(kind_node_image_digest "${K8S_VERSION}")"
  then
    echo "Can not reuse kind environment $KIND_NAME"
    reset_k8s
    return
  fi

  if [ -n "$E2E_EXTRA_MOUNT_BUILD_PATH" ]
  then
    k8s_copy_to_extra_mount_build_path
  fi

  echo "Reusing kind environment $KIND_NAME"
}

reset_k8s() {
  check_kind_version
  check_kind_image_exists
  # Only creating a cluster needs the delegation, and asking podman for it is
  # expensive, so this is not part of check_kind_podman_support.
  check_kind_podman_cgroup_delegation

  if [ -n "$E2E_EXTRA_MOUNT_BUILD_PATH" ]
  then
    k8s_copy_to_extra_mount_build_path
    KIND_EXTRA_MOUNTS="$KIND_EXTRA_MOUNTS
      $(realpath "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/operator/target/quarkus-app)
      $(realpath "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/restapi/target/quarkus-app)
      $(realpath "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/admin-ui/target/public)
      $(realpath "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/cluster-controller/target/quarkus-app)
      $(realpath "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/stream/target/quarkus-app)"
  fi

  echo "Setting up kind environment $KIND_NAME..."

  # Asking the engine is expensive, in particular a rootless podman that has to
  # walk its storage to answer, so resolve it once for the whole configuration.
  local KIND_BACKING_FILESYSTEM
  KIND_BACKING_FILESYSTEM="$(kind_backing_filesystem)"

  if [ -n "$KIND_CONTAINERD_CACHE_PATH" ]
  then
    echo "Setting up kind containerd cache in $KIND_CONTAINERD_CACHE_PATH..."
    if [ "$KIND_CONTAINERD_CACHE_RESET" = true ]
    then
      kind_host_reset_dir "$KIND_CONTAINERD_CACHE_PATH"
    fi
  fi

  if [ -n "$K8S_EXTRA_PORT" ]
  then
    echo "Setting up kind port $K8S_EXTRA_PORT..."
  fi

  delete_k8s
  if [ "$KIND_LOG_RESOURCES" = true ]
  then
    kind_host_write "$KIND_LOG_RESOURCES_POLICY_HOST_PATH" << EOF
# Log all requests at the RequestResponse level.
apiVersion: audit.k8s.io/v1
kind: Policy
rules:
- level: RequestResponse
EOF
  fi
  cat << EOF > "$TARGET_PATH/kind-config.yaml"
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
featureGates:
$(
  if [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -ge "$(echo "1.20" | tr . '\n' | xargs -I @ printf '%05d' @)" ] \
      && [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -lt "$(echo "1.32" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    cat << INNER_INNER_EOF
  HPAContainerMetrics: true
INNER_INNER_EOF
  fi
)
$(
  if [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -ge "$(echo "1.27" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    cat << INNER_INNER_EOF
  InPlacePodVerticalScaling: true
INNER_INNER_EOF
  fi
)
$(
  if [ -n "$KIND_CONTAINERD_CACHE_PATH" ] \
    || [ "$KIND_BACKING_FILESYSTEM" = zfs ] || [ "$KIND_BACKING_FILESYSTEM" = btrfs ]
  then
    cat << INNER_EOF
containerdConfigPatches:
- |-
$(
  if [ -n "$KIND_CONTAINERD_CACHE_PATH" ]
  then
    cat << INNER_INNER_EOF
 
 root = "/containerd-cache"
INNER_INNER_EOF
  fi
  if [ "$KIND_BACKING_FILESYSTEM" = zfs ] \
    || ([ -d "$KIND_CONTAINERD_CACHE_PATH" ] \
      && df -T "$KIND_CONTAINERD_CACHE_PATH" | tail -n 1 | tr -s ' ' | cut -d ' ' -f 2 | grep -q '^zfs$')
  then
    cat << INNER_INNER_EOF
 [plugins."io.containerd.grpc.v1.cri".containerd]
 snapshotter = "native"
INNER_INNER_EOF
  fi
  if [ "$KIND_BACKING_FILESYSTEM" = btrfs ] \
    || ([ -d "$KIND_CONTAINERD_CACHE_PATH" ] \
      && df -T "$KIND_CONTAINERD_CACHE_PATH" | tail -n 1 | tr -s ' ' | cut -d ' ' -f 2 | grep -q '^btrfs$')
  then
    cat << INNER_INNER_EOF
 [plugins."io.containerd.grpc.v1.cri".containerd]
 snapshotter = "btrfs"
INNER_INNER_EOF
  fi
)
INNER_EOF
  fi
)
networking:
  ipFamily: "${K8S_IP_FAMILY}"
  disableDefaultCNI: $(if [ "$K8S_DISABLE_CALICO" != true ]; then printf true; else printf false; fi)
  apiServerAddress: "0.0.0.0"
nodes:
- role: control-plane
  labels:
    ingress-ready: true
  kubeadmConfigPatches:
  - |
    kind: ClusterConfiguration
    apiServer:
        extraArgs:
          enable-admission-plugins: NodeRestriction,OwnerReferencesPermissionEnforcement
$(
  if [ "$KIND_LOG_RESOURCES" = true ]
  then
    cat << INNER_EOF
          # enable auditing flags on the API server
          audit-log-path: /var/log/kubernetes/kube-apiserver-audit.log
          audit-policy-file: /etc/kubernetes/policies/audit-policy.yaml
        # mount new files / directories on the control plane
        extraVolumes:
          - name: audit-policies
            hostPath: /etc/kubernetes/policies
            mountPath: /etc/kubernetes/policies
            readOnly: true
            pathType: "DirectoryOrCreate"
          - name: "audit-logs"
            hostPath: "/var/log/kubernetes"
            mountPath: "/var/log/kubernetes"
            readOnly: false
            pathType: DirectoryOrCreate
INNER_EOF
  fi
  if [ -n "$K8S_EXTRA_PORT" ]
  then
    cat << INNER_EOF
  extraPortMappings:
  - containerPort: $(echo "$K8S_EXTRA_PORT" | cut -d : -f 1)
    hostPort: $(echo "$K8S_EXTRA_PORT" | cut -d : -f 2)
    listenAddress: "$(echo "$K8S_EXTRA_PORT" | cut -d : -f 3)"
    protocol: "$(echo "$K8S_EXTRA_PORT" | cut -d : -f 4)"
INNER_EOF
  fi
  if [ -n "$KIND_EXTRA_MOUNTS" ] \
    || [ -n "$KIND_CONTAINERD_CACHE_PATH" ] \
    || [ "$KIND_LOG" = true ] \
    || [ "$KIND_LOG_RESOURCES" = true ]
  then
    cat << INNER_EOF
  extraMounts:
INNER_EOF
  fi
  if [ -n "$KIND_EXTRA_MOUNTS" ]
  then
    for KIND_EXTRA_MOUNT in $KIND_EXTRA_MOUNTS
    do
      cat << INNER_EOF
  - hostPath: $KIND_EXTRA_MOUNT
    containerPath: $KIND_EXTRA_MOUNT
INNER_EOF
    done
  fi
  if [ -n "$KIND_CONTAINERD_CACHE_PATH" ]
  then
    kind_host_mkdir "$KIND_CONTAINERD_CACHE_PATH"
    cat << INNER_EOF
  - hostPath: $KIND_CONTAINERD_CACHE_PATH
    containerPath: /containerd-cache
INNER_EOF
  fi
  if [ "$KIND_LOG" = true ]
  then
    kind_host_mkdir "$KIND_LOG_HOST_PATH"
    cat << INNER_EOF
  - hostPath: $KIND_LOG_HOST_PATH
    containerPath: /var/log
INNER_EOF
  fi
  if [ "$KIND_LOG_RESOURCES" = true ]
  then
    cat << INNER_EOF
  - hostPath: $KIND_LOG_RESOURCES_POLICY_HOST_PATH
    containerPath: /etc/kubernetes/policies/audit-policy.yaml
    readOnly: true
INNER_EOF
  fi
  for KIND_NODE in $(seq 2 "$KIND_NODES")
  do
    cat << INNER_EOF
- role: worker
INNER_EOF
  done
)
EOF

  try_function flock "$KIND_LOCK_PATH" \
    "$KIND" create cluster --name "$KIND_NAME" --config "$TARGET_PATH/kind-config.yaml" \
    --image "kindest/node:v$(get_kind_image "${K8S_VERSION}")"
  if ! "$RESULT" && [ -n "$KIND_CONTAINERD_CACHE_PATH" ] && [ "$KIND_CONTAINERD_CACHE_RESET" != true ]
  then
    echo "Kind failed to create cluster with cache enabled. Resetting cache and retrying!"
    KIND_CONTAINERD_CACHE_RESET=true reset_k8s
    return
  fi

  if [ "$KIND_INSTALL_NFS" = "true" ]
  then
    echo "Setting up NFT tools for kind..."
    "$KIND" get nodes --name "$KIND_NAME" \
      | xargs -r -n 1 -I % -P "$E2E_PARALLELISM" sh -ec "
      $CONTAINER_ENGINE exec '%' sh -c 'DEBIAN_FRONTEND=noninteractive apt-get update -y -qq < /dev/null > /dev/null'
      $CONTAINER_ENGINE exec '%' sh -c 'DEBIAN_FRONTEND=noninteractive apt-get install -y -qq nfs-common < /dev/null > /dev/null'
      "
  fi

  update_k8s_config

  if [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
      -eq "$(echo "1.12" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
  then
    echo "Patch coredns to version 1.3.1 (see https://github.com/coredns/coredns/issues/2391)..."
    kubectl patch deployment -n kube-system coredns --type json \
      --patch '[{"op":"replace","path":"/spec/template/spec/containers/0/image","value":"k8s.gcr.io/coredns:1.3.1"}]'
  fi
  if [ "$K8S_IP_FAMILY" = ipv6 ]
  then
    DOCKER_IPV6="$($CONTAINER_ENGINE inspect "$KIND_NAME-control-plane" --format='{{range .NetworkSettings.Networks}}{{.IPv6Gateway}}{{end}}')"
    kubectl get -oyaml -n=kube-system configmap/coredns \
      | sed "s/forward .*$/forward . [$DOCKER_IPV6]:5300 {/" \
      | kubectl replace -f -
  fi

  if [ "$K8S_DISABLE_CALICO" != true ]
  then
    echo "Setting up calico for kind..."
    until kubectl get node --template '{{ if (index .items 0).spec.podCIDR }}true{{ end }}' | grep -q 'true'
    do
      sleep 3
    done
    K8S_POD_CIDR="$(kubectl get node --template '{{ (index .items 0).spec.podCIDR }}')"
    if [ "$(echo "$K8S_VERSION" | tr . '\n' | head -n 2 | xargs -I @ printf '%05d' @)" \
        -ge "$(echo "1.22" | tr . '\n' | xargs -I @ printf '%05d' @)" ]
    then
      kubectl replace --force -f https://raw.githubusercontent.com/projectcalico/calico/v3.26.4/manifests/tigera-operator.yaml
      # The tigera-operator image is the only Calico image pulled by its own
      # in-cluster Deployment instead of through the architecture-aware image
      # loaders. With a persistent containerd cache the node can serve a stale
      # or wrong-architecture image for it (observed on arm64 as
      # `exec: "operator": executable file not found in $PATH`), which leaves
      # the cluster without a CNI so every pod stays Pending and the operator
      # install times out. Force a host-architecture pull of the operator image
      # onto the node and restart the Deployment so it starts from it.
      wait_until kubectl get deployment tigera-operator -n tigera-operator
      TIGERA_OPERATOR_IMAGE="$(kubectl get deployment tigera-operator -n tigera-operator \
        -o jsonpath='{.spec.template.spec.containers[0].image}')"
      if [ -n "$TIGERA_OPERATOR_IMAGE" ]
      then
        try_function pull_image_k8s "$TIGERA_OPERATOR_IMAGE"
        "$RESULT" || echo "Warning: could not pre-pull $TIGERA_OPERATOR_IMAGE for host platform"
        kubectl rollout restart deployment/tigera-operator -n tigera-operator
      fi
      wait_until kubectl  replace --force -f https://raw.githubusercontent.com/projectcalico/calico/v3.26.4/manifests/custom-resources.yaml
      kubectl patch installations.operator.tigera.io default --type json \
        -p '[{"op":"replace","path":"/spec/calicoNetwork/ipPools/0/cidr","value":"'"$K8S_POD_CIDR"'"}]'
    else
      kubectl apply -f https://docs.projectcalico.org/v3.12/manifests/calico.yaml
      kubectl -n kube-system set env daemonset/calico-node CALICO_IPV4POOL_CIDR="$K8S_POD_CIDR"
      kubectl -n kube-system set env daemonset/calico-node FELIX_IGNORELOOSERPF=true
    fi
    echo "...done"
  fi

  if [ "$K8S_DISABLE_VOLUME_SNAPSHOT" != true ]
  then
    echo "Setting up CSI Hostpath Driver with Snapshotter for kind..."
    CSI_DRIVER_HOST_PATH_DIR=""
    SNAPSHOTTER_VERSION=""
    case "$(printf %s "$K8S_VERSION" | cut -d . -f 1-2)" in
      1.18) CSI_DRIVER_HOST_PATH_DIR=v1.7.2-k8s-1.18; SNAPSHOTTER_VERSION=v3.0.3 ;;
      1.19) CSI_DRIVER_HOST_PATH_DIR=v1.7.3-k8s-1.19; SNAPSHOTTER_VERSION=v3.0.3 ;;
      1.20) CSI_DRIVER_HOST_PATH_DIR=v1.9.0-k8s-1.21; SNAPSHOTTER_VERSION=v3.0.3 ;;
      1.21) CSI_DRIVER_HOST_PATH_DIR=v1.9.0-k8s-1.21; SNAPSHOTTER_VERSION=v6.3.2 ;;
      1.22|1.23) CSI_DRIVER_HOST_PATH_DIR=v1.10.0-k8s-1.22; SNAPSHOTTER_VERSION=v6.3.2 ;;
      1.24) CSI_DRIVER_HOST_PATH_DIR=v1.11.0-k8s-1.24; SNAPSHOTTER_VERSION=v6.3.2 ;;
      1.25) CSI_DRIVER_HOST_PATH_DIR=v1.11.0-k8s-1.25; SNAPSHOTTER_VERSION=v6.3.2 ;;
      1.26) CSI_DRIVER_HOST_PATH_DIR=v1.12.0-k8s-1.26; SNAPSHOTTER_VERSION=v6.3.2 ;;
      # v1.12.0 has no deploy/kubernetes-1.28 dir; reuse the 1.27 layout for 1.28.
      1.27|1.28) CSI_DRIVER_HOST_PATH_DIR=v1.12.0-k8s-1.27; SNAPSHOTTER_VERSION=v6.3.2 ;;
      1.29|1.30|1.31|1.32|1.33|1.34|1.35) CSI_DRIVER_HOST_PATH_DIR=master-k8s-1.30; SNAPSHOTTER_VERSION=v6.3.2 ;;
    esac
    if [ -z "$CSI_DRIVER_HOST_PATH_DIR" ]
    then
      echo "No vendored csi-driver-host-path config for K8s $K8S_VERSION"
      exit 1
    fi

    SNAPSHOTTER_RESOURCES_PATH="$E2E_PATH/resources/external-snapshotter/${SNAPSHOTTER_VERSION}"
    CSI_DRIVER_HOST_PATH_INSTALL="$E2E_PATH/resources/csi-driver-host-path/${CSI_DRIVER_HOST_PATH_DIR}/install.yaml"
    if [ ! -d "$SNAPSHOTTER_RESOURCES_PATH" ]
    then
      echo "Local external-snapshotter resources not found at $SNAPSHOTTER_RESOURCES_PATH"
      exit 1
    fi
    if [ ! -f "$CSI_DRIVER_HOST_PATH_INSTALL" ]
    then
      echo "Vendored csi-driver-host-path install.yaml not found at $CSI_DRIVER_HOST_PATH_INSTALL"
      exit 1
    fi

    # Apply VolumeSnapshot CRDs
    kubectl replace --force -f "$SNAPSHOTTER_RESOURCES_PATH/snapshot.storage.k8s.io_volumesnapshotclasses.yaml"
    kubectl replace --force -f "$SNAPSHOTTER_RESOURCES_PATH/snapshot.storage.k8s.io_volumesnapshotcontents.yaml"
    kubectl replace --force -f "$SNAPSHOTTER_RESOURCES_PATH/snapshot.storage.k8s.io_volumesnapshots.yaml"
    # Create snapshot controller
    kubectl replace --force -f "$SNAPSHOTTER_RESOURCES_PATH/rbac-snapshot-controller.yaml"
    kubectl replace --force -f "$SNAPSHOTTER_RESOURCES_PATH/setup-snapshot-controller.yaml"
    # Apply CSI Hostpath Driver (pre-rendered, namespaced to kube-system)
    kubectl apply -f "$CSI_DRIVER_HOST_PATH_INSTALL"
    kubectl get storageclass -o name | xargs -I % kubectl annotate % --overwrite storageclass.kubernetes.io/is-default-class=false
    kubectl annotate storageclass csi-hostpath-sc --overwrite storageclass.kubernetes.io/is-default-class=true
    kubectl annotate volumesnapshotclass csi-hostpath-snapclass --overwrite snapshot.storage.kubernetes.io/is-default-class="true"
    echo "...done"
  fi

  if [ "$ENABLE_METRIC_SERVER" = true ]
  then
    setup_metric_server
  fi
}

k8s_copy_to_extra_mount_build_path() {
  if [ -z "$PROJECT_PATH" ]
  then
    echo "PROJECT_PATH not set"
    return 1
  fi
  if [ -z "$E2E_EXTRA_MOUNT_BUILD_PATH" ]
  then
    echo "E2E_EXTRA_MOUNT_BUILD_PATH not set"
    return 1
  fi
  mkdir -p "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/operator/target/quarkus-app
  cp -a "$PROJECT_PATH"/stackgres-k8s/src/operator/target/quarkus-app/. \
    "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/operator/target/quarkus-app/.
  mkdir -p "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/restapi/target/quarkus-app
  cp -a "$PROJECT_PATH"/stackgres-k8s/src/restapi/target/quarkus-app/. \
    "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/restapi/target/quarkus-app/.
  mkdir -p "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/admin-ui/target/public
  cp -a "$PROJECT_PATH"/stackgres-k8s/src/admin-ui/target/public/. \
    "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/admin-ui/target/public/.
  mkdir -p "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/cluster-controller/target/quarkus-app
  cp -a "$PROJECT_PATH"/stackgres-k8s/src/cluster-controller/target/quarkus-app/. \
    "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/cluster-controller/target/quarkus-app/.
  mkdir -p "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/stream/target/quarkus-app
  cp -a "$PROJECT_PATH"/stackgres-k8s/src/stream/target/quarkus-app/. \
    "$E2E_EXTRA_MOUNT_BUILD_PATH"/stackgres-k8s/src/stream/target/quarkus-app/.
}

setup_metric_server() {
  echo "Setting up metric server for kind..."
  kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml
  kubectl patch -n kube-system deploy metrics-server --type json \
    -p '[{"op":"add","path":"/spec/template/spec/containers/0/args/5","value":"--kubelet-insecure-tls"}]'
  echo "...done"
}

delete_k8s() {
  check_kind_version

  if "$KIND" get clusters | grep -q "^$KIND_NAME$"
  then
    echo "Deleting kind environment $KIND_NAME..."

    "$KIND" delete cluster --name "$KIND_NAME" || true

    echo "...done"
  fi

  screen -ls 2>/dev/null | grep '\.kind-tag-import-images' \
    | tr '[:space:]' ' ' | cut -d ' ' -f 2 | cut -d . -f 1 \
    | xargs -r -I % kill % || true
  if [ "$K8S_IP_FAMILY" = ipv6 ]
  then
    screen -ls 2>/dev/null | grep '\.kind-ipv6-dns-socat' \
      | tr '[:space:]' ' ' | cut -d ' ' -f 2 | cut -d . -f 1 \
      | xargs -r -I % kill % || true
  fi
}

has_image_k8s() {
  check_kind_version

  local KIND_IMAGE_ID
  KIND_IMAGE_ID="$( ($CONTAINER_ENGINE exec "${KIND_NAME}-control-plane" crictl inspecti -o json "$1" 2>/dev/null || printf '{"status": {"id": "unknown"}}') | jq -r '.status.id' | grep -v '^$')"
  if [ "$KIND_IMAGE_ID" != unknown ]
  then
    return
  fi
  return 1
}

# With Docker's containerd image store enabled, `docker inspect .ID` on a
# multi-platform image returns the OCI index / Docker manifest list digest,
# while `crictl inspecti` inside kind reports the host-platform config digest.
# Walk the local index -> host-platform manifest -> `.config.digest` so callers
# can compare apples to apples. Echoes the resolved digest or nothing.
#
# podman stores one image per platform, so `podman inspect .ID` already is the
# config digest that `crictl inspecti` reports and there is nothing to resolve.
host_platform_config_digest() {
  if container_engine_is_podman
  then
    return
  fi
  local IMAGE_NAME="$1"
  local INDEX_DIGEST="${2#sha256:}"
  [ -n "$INDEX_DIGEST" ] || return
  local ARCHIVE
  ARCHIVE="$(mktemp)"
  # Use a plain `docker save` (no --platform) so this works against older
  # Docker CLIs too; the archive is daemon-produced and exposes the OCI index
  # / Docker manifest list as a blob even when the image is multi-platform.
  if ! docker save -o "$ARCHIVE" "$IMAGE_NAME" >/dev/null 2>&1
  then
    rm -f "$ARCHIVE"
    return
  fi
  local INDEX_MT
  INDEX_MT="$(tar -xOf "$ARCHIVE" index.json 2>/dev/null | jq -r '.manifests[0].mediaType // empty')"
  case "$INDEX_MT" in
    application/vnd.oci.image.index.v1+json|application/vnd.docker.distribution.manifest.list.v2+json) ;;
    *)
      rm -f "$ARCHIVE"
      return
      ;;
  esac
  local HOST_PLATFORM HOST_OS HOST_ARCH CHILD_DIGEST CONFIG_DIGEST
  HOST_PLATFORM="$(kind_engine_platform)"
  HOST_OS="${HOST_PLATFORM%%/*}"
  HOST_ARCH="${HOST_PLATFORM##*/}"
  CHILD_DIGEST="$(tar -xOf "$ARCHIVE" "blobs/sha256/$INDEX_DIGEST" 2>/dev/null \
    | jq -r --arg os "$HOST_OS" --arg arch "$HOST_ARCH" \
        '(.manifests // [])[] | select(.platform.os == $os and .platform.architecture == $arch) | .digest' \
    | grep -v '^$' | head -n 1)"
  if [ -n "$CHILD_DIGEST" ]
  then
    CONFIG_DIGEST="$(tar -xOf "$ARCHIVE" "blobs/sha256/${CHILD_DIGEST#sha256:}" 2>/dev/null \
      | jq -r '.config.digest // empty')"
  fi
  rm -f "$ARCHIVE"
  [ -n "$CONFIG_DIGEST" ] && printf '%s' "$CONFIG_DIGEST"
}

load_image_k8s() {
  check_kind_version

  local IMAGE_ID
  IMAGE_ID="$(kind_local_image_id "$1")"
  local KIND_IMAGE_ID
  KIND_IMAGE_ID="$( ($CONTAINER_ENGINE exec "${KIND_NAME}-control-plane" crictl inspecti -o json "$1" 2>/dev/null || printf '{"status": {"id": "unknown"}}') | jq -r '.status.id' | grep -v '^$')"
  if [ "$IMAGE_ID" = unknown ] && [ "$KIND_IMAGE_ID" != unknown ]
  then
    echo "Image $1 already loaded in kind environemnt $KIND_NAME"
    return
  fi
  if [ "$IMAGE_ID" != unknown ] && [ "$IMAGE_ID" != "$KIND_IMAGE_ID" ]
  then
    local RESOLVED_IMAGE_ID
    RESOLVED_IMAGE_ID="$(host_platform_config_digest "$1" "$IMAGE_ID")"
    [ -n "$RESOLVED_IMAGE_ID" ] && IMAGE_ID="$RESOLVED_IMAGE_ID"
  fi
  if [ "$KIND_IMAGE_ID" = "$IMAGE_ID" ] && [ "$IMAGE_ID" != unknown ]
  then
    echo "Image $1 already loaded in kind environemnt $KIND_NAME"
    return
  fi
  # Workaround kubernetes-sigs/kind#3795: `kind load docker-image` imports with
  # `ctr images import --all-platforms`, which fails when Docker's containerd
  # image store is enabled because `docker save` emits a multi-platform OCI
  # archive missing blobs for non-host platforms. podman stores one image per
  # platform and always saves a single platform archive, so it needs none of it.
  local PLATFORM
  PLATFORM="$(kind_engine_platform)"
  local ARCHIVE
  ARCHIVE="$(mktemp)"
  if container_engine_is_podman
  then
    $CONTAINER_ENGINE save -o "$ARCHIVE" "$1"
  elif docker save --help 2>&1 | grep -q -- '--platform'
  then
    docker save --platform "$PLATFORM" -o "$ARCHIVE" "$1"
  else
    # Docker CLI <28 has no --platform; call the daemon API directly. The
    # API has accepted ?platform on /images/get since Docker 28 / API 1.48.
    local SOCK
    case "${DOCKER_HOST:-unix:///var/run/docker.sock}" in
      unix://*)
        SOCK="${DOCKER_HOST#unix://}"
        [ -n "$SOCK" ] || SOCK=/var/run/docker.sock
        ;;
      *)
        echo "docker save --platform unavailable and DOCKER_HOST=$DOCKER_HOST is not a unix socket" >&2
        rm -f "$ARCHIVE"
        return 1
        ;;
    esac
    local PLATFORM_JSON
    PLATFORM_JSON="$(printf '%s' "$PLATFORM" | jq -Rc \
      'split("/") | {os: .[0], architecture: .[1]} + (if length > 2 then {variant: .[2]} else {} end)')"
    curl --silent --show-error --fail --unix-socket "$SOCK" --output "$ARCHIVE" \
      --get --data-urlencode "names=$1" --data-urlencode "platform=$PLATFORM_JSON" \
      'http://docker/images/get'
  fi
  local RC=0
  "$KIND" get nodes --name "$KIND_NAME" \
    | xargs -r -n 1 -I % -P "$E2E_PARALLELISM" sh -ec "
      $CONTAINER_ENGINE exec --privileged -i % ctr --namespace=k8s.io images import --digests --snapshotter=overlayfs - < '$ARCHIVE'
      " || RC=$?
  rm -f "$ARCHIVE"
  [ "$RC" -eq 0 ] || return "$RC"

  echo "Loaded image $1 in kind environemnt $KIND_NAME"
}

pull_image_k8s() {
  check_kind_version

  local IMAGE_ID
  IMAGE_ID="$(kind_local_image_id "$1")"
  local KIND_IMAGE_ID
  KIND_IMAGE_ID="$( ($CONTAINER_ENGINE exec "${KIND_NAME}-control-plane" crictl inspecti -o json "$1" 2>/dev/null || printf '{"status": {"id": "unknown"}}') | jq -r '.status.id' | grep -v '^$')"
  if [ "$IMAGE_ID" = unknown ] && [ "$KIND_IMAGE_ID" != unknown ]
  then
    echo "Image $1 already loaded in kind environemnt $KIND_NAME"
    return
  fi
  if [ "$IMAGE_ID" != unknown ] && [ "$IMAGE_ID" != "$KIND_IMAGE_ID" ]
  then
    local RESOLVED_IMAGE_ID
    RESOLVED_IMAGE_ID="$(host_platform_config_digest "$1" "$IMAGE_ID")"
    [ -n "$RESOLVED_IMAGE_ID" ] && IMAGE_ID="$RESOLVED_IMAGE_ID"
  fi
  if [ "$KIND_IMAGE_ID" = "$IMAGE_ID" ] && [ "$IMAGE_ID" != unknown ]
  then
    echo "Image $1 already loaded in kind environemnt $KIND_NAME"
    return
  fi

  local AUTH
  AUTH="$(jq -r '.auths|to_entries|.[]|.key + "|" + .value.auth' "$REGISTRY_AUTH_FILE" \
    | grep -F "${1%%/*}" | head -n 1 | cut -d '|' -f 2)"
  if [ -n "$AUTH" ]
  then
    $CONTAINER_ENGINE exec "${KIND_NAME}-control-plane" ctr -n k8s.io i pull --user "$(printf %s "$AUTH" | base64 -d)" "$1" > /dev/null
  else
    $CONTAINER_ENGINE exec "${KIND_NAME}-control-plane" ctr -n k8s.io i pull "$1" > /dev/null
  fi

  echo "Pulled image $1 in kind environemnt $KIND_NAME"
}

tag_image_k8s() {
  check_kind_version

  $CONTAINER_ENGINE exec "${KIND_NAME}-control-plane" ctr -n k8s.io images tag --force "$1" "$2"

  echo "Tagged image $1 as $2 in kind environemnt $KIND_NAME"
}

get_latest_image_k8s() {
  check_kind_version

  local IMAGE="$1"
  $CONTAINER_ENGINE exec "$KIND_NAME-control-plane" crictl images -o json \
    | jq -r '.images|map(select(.repoTags|any(.|startswith("'"${IMAGE%%:*}"':"))))|last|.repoTags|last'
}

load_certificate_k8s() {
  check_kind_version

  echo "Loading certificate $1 in kind environemnt $KIND_NAME..."

  "$KIND" get nodes --name "$KIND_NAME" \
    | xargs -r -n 1 -I % -P "$E2E_PARALLELISM" sh -ec "
    $CONTAINER_ENGINE cp '$1' '%':/usr/local/share/ca-certificates/validator.crt
    $CONTAINER_ENGINE exec '%' sh -c update-ca-certificates
    "

  echo "...done"
}

