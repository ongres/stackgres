#!/bin/sh

. "$SPEC_PATH/abstract/dbops-major-version-upgrade"

e2e_test_extra_hash() {
  "$SHELL" "$PROJECT_PATH/stackgres-k8s/ci/build/build-functions.sh" path_hash \
    "$(realpath --relative-to "$PROJECT_PATH" "$SPEC_PATH/abstract/dbops-major-version-upgrade")"
}

e2e_test() {
  run_test "Checking that major version upgrade with primary not first is working" check_major_version_upgrade_with_primary_not_first_is_working
}

check_major_version_upgrade_with_primary_not_first_is_working() {
  reset_cluster

  # patronictl exits with success when it prints "Switchover failed", and the former primary is
  # left restarting after a successful one, so the switchover is retried until it is performed and
  # the cluster is awaited to converge: the operation has to start on a healthy cluster whose
  # primary is the last instance, which is what this test is about.
  wait_until eval '! kubectl exec -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME-0" -c patroni -- \
    patronictl switchover "$CLUSTER_NAME" --primary "$CLUSTER_NAME-0" --candidate "$CLUSTER_NAME-1" --force \
    | grep -q "^Switchover failed"'
  wait_until eval '[ "$(kubectl get pod -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME-0" \
    --template="{{ .metadata.labels.role }}" 2>/dev/null)" = replica ]'
  wait_until eval 'kubectl get endpoints --namespace "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" \
    --template="{{ .metadata.annotations.leader }}" | grep -qxF "$CLUSTER_NAME-1"'

  cat << EOF | kubectl create -f -
apiVersion: stackgres.io/v1
kind: SGDbOps
metadata:
  name: $DBOPS_NAME
  namespace: $CLUSTER_NAMESPACE
spec:
  sgCluster: $CLUSTER_NAME
  op: majorVersionUpgrade
  majorVersionUpgrade:
    postgresVersion: "$E2E_MAJOR_TARGET_POSTGRES_VERSION"
    sgPostgresConfig: postgresconf-for-major-version-upgrade
    postgresExtensions:
    - name: pg_repack
      version: $TARGET_PG_REPACK_VERSION
EOF

  check_major_version_upgrade

  kubectl delete sgdbops -n "$CLUSTER_NAMESPACE" "$DBOPS_NAME"
}
