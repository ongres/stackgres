#!/bin/sh

. "$SPEC_PATH/abstract/patroni"

. "$SPEC_PATH/abstract/sql-scripts"

e2e_test_extra_hash() {
  printf '%s\n' E2E_CITUS_POSTGRES_VERSION="$E2E_CITUS_POSTGRES_VERSION"
  "$SHELL" "$PROJECT_PATH/stackgres-k8s/ci/build/build-functions.sh" path_hash \
    "$(realpath --relative-to "$PROJECT_PATH" "$SPEC_PATH/abstract/patroni")"
  "$SHELL" "$PROJECT_PATH/stackgres-k8s/ci/build/build-functions.sh" path_hash \
    "$(realpath --relative-to "$PROJECT_PATH" "$SPEC_PATH/abstract/sql-scripts")"
  "$SHELL" "$PROJECT_PATH/stackgres-k8s/ci/build/build-functions.sh" path_hash \
    "$(realpath --relative-to "$PROJECT_PATH" "$SPEC_PATH/sql-scripts.sakila.sql")"
}

e2e_test_install() {
  E2E_POSTGRES_VERSION="${E2E_CITUS_POSTGRES_VERSION:-$E2E_POSTGRES_VERSION}"
  CLUSTER_NAME="$(get_sgshardedcluster_name "$SPEC_NAME")"

  install_minio

  cat << 'EOF' | kubectl create -n "$CLUSTER_NAMESPACE" secret generic sql-scripts-sakila-user \
    --from-literal=create-sakila-user.sql="$(cat)"
DO $$
BEGIN
  IF NOT EXISTS (SELECT * FROM pg_roles WHERE rolname = 'sakila') THEN
    EXECUTE 'CREATE USER sakila WITH PASSWORD ''sakila'';';
  END IF;
  IF NOT EXISTS (SELECT * FROM pg_dist_authinfo WHERE rolename = 'sakila') THEN
    INSERT INTO pg_dist_authinfo (nodeid, rolename, authinfo) VALUES (0, 'sakila', 'password=sakila');
  END IF;
END$$;
EOF

  kubectl create -n "$CLUSTER_NAMESPACE" configmap sql-scripts-sakila-schema \
    --from-file=create-sakila-schema.sql="$SPEC_PATH/sql-scripts.sakila.sql"

  create_or_replace_sharded_cluster "$CLUSTER_NAME" "$CLUSTER_NAMESPACE" "3" "2" "0"

  deploy_curl_pod "$CLUSTER_NAMESPACE"

  wait_pods_running "$CLUSTER_NAMESPACE" 7
  wait_sharded_cluster "$CLUSTER_NAME" "$CLUSTER_NAMESPACE"
}

e2e_test() {
  run_test "Checking that is possible to connect using services is working" service_check

  run_test "Checking that sharded technology is configured and working" sharded_check

  run_test "Checking that the nodes connect to each other through the connection pooler" \
    pooler_connections_check

  run_test "Check that pgbouncer database is accesible using the service" pgbouncer_database_check

  run_test "Checking that managed SQL is working" check_managed_sql_is_working

  run_test "Checking that query routers and the routers service are functional" query_routers_check

  run_test "Checking that a settled SGShardedCluster reconciles to a no-op" \
    check_settled_sharded_cluster_does_not_emit_cluster_updated

  run_test "Checking that a query router override can reference its own SGPostgresConfig" \
    query_router_postgres_config_override_check

  run_test "Checking that query routers are removed from and added to pg_dist_node on scaling" \
    query_routers_scaling_check
}

# A settled SGShardedCluster must reconcile to a no-op. For Citus every child cluster renews its
# Patroni leader lock on an Endpoints labelled with the SGShardedCluster name, which re-triggers
# the SGShardedCluster reconciliation every one or two seconds. If any of those cycles is not a
# no-op a ClusterUpdated event is emitted at that rate, forever (see issue #3219).
check_settled_sharded_cluster_does_not_emit_cluster_updated() {
  COUNT_BEFORE="$(count_cluster_updated_events)"

  # Cover a good number of reconciliation cycles of a cluster that is not being modified.
  sleep 60

  COUNT_AFTER="$(count_cluster_updated_events)"

  if [ "$COUNT_AFTER" = "$COUNT_BEFORE" ]
  then
    success "The settled SGShardedCluster did not emit any ClusterUpdated event"
  else
    kubectl get events -n "$CLUSTER_NAMESPACE" \
      --field-selector "reason=ClusterUpdated,involvedObject.name=$CLUSTER_NAME" \
      -o yaml || true
    fail "The settled SGShardedCluster emitted $((COUNT_AFTER - COUNT_BEFORE)) ClusterUpdated" \
      "events, the reconciliation is not converging"
  fi
}

count_cluster_updated_events() {
  kubectl get events -n "$CLUSTER_NAMESPACE" \
    --field-selector "reason=ClusterUpdated,involvedObject.name=$CLUSTER_NAME" \
    --template '{{ range .items }}{{ if eq .involvedObject.kind "SGShardedCluster" }}{{ .count }}{{ printf "\n" }}{{ end }}{{ end }}' \
    | awk '{ total += $1 } END { print total + 0 }'
}

service_check() {
  RESPONSE_PRIMARY="$(run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432)"

  if [ "$RESPONSE_PRIMARY" = "1" ]
  then
    success "Connections are possible using services"
  else
    fail "Cannot connect to primary db using a kubernetes service"
  fi
}

sharded_check() {
  local RESULT EXIT_CODE
  try_function wait_until eval 'run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 \
    -d citus -q "SELECT COUNT(*) FROM master_get_active_worker_nodes()" | grep -xF 2'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Sharding coordinator service is working"
  else
    fail "Sharding coordinator service is not working"
  fi

  try_function wait_until eval 'run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 \
    -d citus -q "SELECT COUNT(*) FROM master_get_active_worker_nodes()" | grep -xF 2'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Sharding primary coordinator service is working"
  else
    fail "Sharding primary coordinator service is not working"
  fi

  try_function wait_until eval 'run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME-workers" -i 1 -p 5432 \
    -d citus -q "SELECT pg_is_in_recovery()" | grep -xF f'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Sharding workers service is working"
  else
    fail "Sharding workers service is not working"
  fi
}

pooler_connections_check() {
  local RESULT EXIT_CODE
  local POOLINFO_QUERY="SELECT COUNT(*) FROM pg_dist_node LEFT JOIN pg_dist_poolinfo USING (nodeid)
    WHERE poolinfo IS DISTINCT FROM 'port=6432'"
  local WORKERS_POOLINFO_QUERY="SELECT bool_and(success AND result = '0')
    FROM run_command_on_workers(\$poolinfo\$$POOLINFO_QUERY\$poolinfo\$)"

  try_function wait_until eval 'run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 \
    -d citus -q "$POOLINFO_QUERY" | grep -xF 0'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "The coordinator connects to the nodes through the connection pooler"
  else
    fail "The coordinator does not connect to the nodes through the connection pooler"
  fi

  try_function wait_until eval 'run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 \
    -d citus -q "$WORKERS_POOLINFO_QUERY" | grep -xF t'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "The workers connect to the nodes through the connection pooler"
  else
    fail "The workers do not connect to the nodes through the connection pooler"
  fi

  try_function wait_until eval 'run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 \
    -d citus -q "SELECT COUNT(*) FROM query_router_test" | grep -xF 0'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "A distributed query can be executed through the connection pooler"
  else
    fail "A distributed query can not be executed through the connection pooler"
  fi
}

pgbouncer_database_check() {
  if kubectl exec -n "$CLUSTER_NAMESPACE" "${CLUSTER_NAME}-coord-0" -c "postgres-util" -- env \
    PGPASSWORD="$(kubectl -n "$CLUSTER_NAMESPACE" get secrets "$CLUSTER_NAME-coord" \
      -o jsonpath='{.data.pgbouncer-admin-password}' | base64 -d)" \
    PGCONNECT_TIMEOUT="$((5 + E2E_TIMEOUT / 10))" \
    psql -q -t -A -U pgbouncer_admin -d pgbouncer -h "$CLUSTER_NAME" -c "SHOW SERVERS" >/dev/null
  then
    success "psql could connect to the pgbouncer database with pgobuncer_admin using service"
  else
    fail "psql could not connect to the pgbouncer database with pgobuncer_admin using service"
  fi

  if kubectl exec -n "$CLUSTER_NAMESPACE" "${CLUSTER_NAME}-coord-0" -c "postgres-util" -- env \
    PGPASSWORD="$(kubectl -n "$CLUSTER_NAMESPACE" get secrets "$CLUSTER_NAME-coord" \
      -o jsonpath='{.data.pgbouncer-stats-password}' | base64 -d)" \
    PGCONNECT_TIMEOUT="$((5 + E2E_TIMEOUT / 10))" \
    psql -q -t -A -U pgbouncer_stats -d pgbouncer -h "$CLUSTER_NAME" -c "SHOW VERSION" >/dev/null
  then
    success "psql could connect to the pgbouncer database with pgobuncer_stats using service"
  else
    fail "psql could not connect to the pgbouncer database with pgobuncer_stats using service"
  fi
}

check_managed_sql_is_working() {
  local NODE=0
  local DATABASE=citus
  check_user_on_sharded_primary
  check_database_on_sharded_primary
  check_schema_on_sharded_primary
}

query_routers_check() {
  local QUERY_ROUTERS=1
  local ROUTER_CLUSTER="$CLUSTER_NAME-router0"
  local ROUTER_SERVICE="$CLUSTER_NAME-routers"
  local RESULT EXIT_CODE

  kubectl patch sgshardedcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" --type merge \
    -p '{"spec":{"coordinator":{"queryRouterClusters":'"$QUERY_ROUTERS"'}}}'

  if try_function wait_until eval '[ "$(kubectl get sgcluster -n "$CLUSTER_NAMESPACE" \
      "$ROUTER_CLUSTER" --template "{{ .spec.instances }}" 2>/dev/null)" = 1 ]' \
    && "$RESULT"
  then
    success "SGCluster $ROUTER_CLUSTER was created for the query router worker"
  else
    fail "SGCluster $ROUTER_CLUSTER was not created"
  fi

  if try_function wait_until eval '[ "$(kubectl get pod -n "$CLUSTER_NAMESPACE" \
      "$ROUTER_CLUSTER-0" --template "{{ .status.phase }}" 2>/dev/null)" = Running ]' \
    && "$RESULT"
  then
    success "Query router pod $ROUTER_CLUSTER-0 is Running"
  else
    fail "Query router pod $ROUTER_CLUSTER-0 did not reach Running phase"
  fi

  if try_function wait_until eval '[ -n "$(kubectl get service -n "$CLUSTER_NAMESPACE" \
      "$ROUTER_SERVICE" --template "{{ .spec.clusterIP }}" 2>/dev/null)" ]' \
    && "$RESULT"
  then
    success "Service $ROUTER_SERVICE is exposed by the operator"
  else
    fail "Service $ROUTER_SERVICE is not exposed by the operator"
  fi

  wait_sharded_cluster "$CLUSTER_NAME" "$CLUSTER_NAMESPACE"

  try_function wait_until eval 'run_query -c "$ROUTER_CLUSTER" -h "$ROUTER_SERVICE" -i 0 -p 5432 \
    -d citus -q "SELECT 1" | grep -xF 1'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Connection through query router service $ROUTER_SERVICE is working"
  else
    fail "Cannot connect through query router service $ROUTER_SERVICE"
  fi

  try_function wait_until eval 'run_query -c "$ROUTER_CLUSTER" -h "$ROUTER_SERVICE" -i 0 -p 5432 \
    -d citus -q "SELECT pg_is_in_recovery()" | grep -xF f'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Query router service $ROUTER_SERVICE points to a read-write Postgres server"
  else
    fail "Query router service $ROUTER_SERVICE does not point to a read-write Postgres server"
  fi

  try_function wait_until eval 'run_query -c "$ROUTER_CLUSTER" -h "$ROUTER_SERVICE" -i 0 -p 5432 \
    -d citus -q "SELECT COUNT(*) FROM pg_dist_node WHERE groupid > 1024 AND NOT shouldhaveshards" | grep -xF 1'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Query router is a worker node that does not have shards"
  else
    fail "Query router is not a worker node that does not have shards"
  fi

  try_function wait_until eval 'run_query -c "$ROUTER_CLUSTER" -h "$ROUTER_SERVICE" -i 0 -p 5432 \
    -d citus -q "INSERT INTO query_router_test VALUES (1)"'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Query router can write to distributed tables"
  else
    fail "Query router can not write to distributed tables"
  fi

  try_function wait_until eval 'run_query -c "$ROUTER_CLUSTER" -h "$ROUTER_SERVICE" -i 0 -p 5432 \
    -d citus -q "SELECT COUNT(*) FROM query_router_test" | grep -xF 1'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Query router can read distributed tables"
  else
    fail "Query router can not read distributed tables"
  fi
}

query_router_postgres_config_override_check() {
  local ROUTER_CLUSTER="$CLUSTER_NAME-router0"
  local ROUTER_SERVICE="$CLUSTER_NAME-routers"
  local PGCONFIG_NAME="$CLUSTER_NAME-router-pgconfig"
  local POSTGRES_MAJOR_VERSION
  POSTGRES_MAJOR_VERSION="$(kubectl get sgcluster -n "$CLUSTER_NAMESPACE" "$ROUTER_CLUSTER" \
    --template '{{ .spec.postgres.version }}')"
  POSTGRES_MAJOR_VERSION="${POSTGRES_MAJOR_VERSION%%.*}"
  local ROUTER_GENERATED_PGCONFIG="$ROUTER_CLUSTER-$POSTGRES_MAJOR_VERSION"
  local WORKER_GENERATED_PGCONFIG="$CLUSTER_NAME-worker0-$POSTGRES_MAJOR_VERSION"
  local RESULT EXIT_CODE

  cat << EOF | kubectl create -f -
apiVersion: stackgres.io/v1
kind: SGPostgresConfig
metadata:
  name: $PGCONFIG_NAME
  namespace: $CLUSTER_NAMESPACE
spec:
  postgresVersion: "$POSTGRES_MAJOR_VERSION"
  postgresql.conf:
    work_mem: '5MB'
EOF

  kubectl patch sgshardedcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" --type merge \
    -p '{"spec":{"workers":{"overrides":[{"index":0,"type":"QueryRouter","configurations":{"sgPostgresConfig":"'"$PGCONFIG_NAME"'"}}]}}}'

  # The override index is zero based within the query routers, so index 0 must select the first
  # query router and must not be applied to the worker with the same index.
  if try_function wait_until eval '[ "$(kubectl get sgpgconfig -n "$CLUSTER_NAMESPACE" \
      "$ROUTER_GENERATED_PGCONFIG" --template "{{ index .spec \"postgresql.conf\" \"work_mem\" }}" \
      2>/dev/null)" = 5MB ]' \
    && "$RESULT"
  then
    success "SGPostgresConfig $ROUTER_GENERATED_PGCONFIG was generated from the overridden SGPostgresConfig"
  else
    fail "SGPostgresConfig $ROUTER_GENERATED_PGCONFIG was not generated from the overridden SGPostgresConfig"
  fi

  if [ "$(kubectl get sgpgconfig -n "$CLUSTER_NAMESPACE" "$WORKER_GENERATED_PGCONFIG" \
    --template '{{ index .spec "postgresql.conf" "work_mem" }}' 2>/dev/null)" != 5MB ]
  then
    success "SGPostgresConfig $WORKER_GENERATED_PGCONFIG was not affected by the query router override"
  else
    fail "SGPostgresConfig $WORKER_GENERATED_PGCONFIG was affected by the query router override"
  fi

  try_function wait_until eval 'run_query -c "$ROUTER_CLUSTER" -h "$ROUTER_SERVICE" -i 0 -p 5432 \
    -d citus -q "SHOW work_mem" | grep -xF 5MB'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Query router is running with the overridden SGPostgresConfig"
  else
    fail "Query router is not running with the overridden SGPostgresConfig"
  fi
}

query_routers_scaling_check() {
  local ROUTER_CLUSTER="$CLUSTER_NAME-router1"
  local ROUTER_GROUP=1026
  local RESULT EXIT_CODE

  # The nodes of the removed groups are only removed from pg_dist_node when enabled, and the
  # reference tables are only replicated to the added nodes when enabled
  kubectl patch sgshardedcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" --type merge \
    -p '{"spec":{"configurations":{"citus":{"enableNodeAutoRemoval":true,"autoReplicateReferenceTables":true}}}}'

  # A query router added once a reference table exists must be activated and get the reference
  # tables, that citus_activate_node does not replicate
  run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 -d citus \
    -q "CREATE TABLE query_routers_scaling_reference (id integer PRIMARY KEY);
      SELECT create_reference_table('query_routers_scaling_reference');"

  set_query_routers 2
  wait_query_router_registered "$ROUTER_CLUSTER" "$ROUTER_GROUP"

  set_query_routers 1

  # The SGCluster of a removed query router is kept running while its group is registered in
  # pg_dist_node since Citus can only remove a primary node that can be reached
  if kubectl get sgcluster -n "$CLUSTER_NAMESPACE" "$ROUTER_CLUSTER" \
    --template '{{ .spec.instances }}' | grep -qxF 1
  then
    success "SGCluster $ROUTER_CLUSTER is kept running while registered in pg_dist_node"
  else
    fail "SGCluster $ROUTER_CLUSTER was scaled down while registered in pg_dist_node"
  fi

  # Patroni does not remove a Citus group that is gone from the DCS, the coordinator must do it
  try_function wait_until eval 'run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 \
    -d citus -q "SELECT COUNT(*) FROM pg_dist_node WHERE groupid = $ROUTER_GROUP" | grep -xF 0'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Query router of group $ROUTER_GROUP was removed from pg_dist_node"
  else
    fail "Query router of group $ROUTER_GROUP was not removed from pg_dist_node"
  fi

  if try_function wait_until eval '[ "$(kubectl get sgcluster -n "$CLUSTER_NAMESPACE" "$ROUTER_CLUSTER" \
      --template "{{ .spec.instances }}")" = 0 ]' \
    && "$RESULT"
  then
    success "SGCluster $ROUTER_CLUSTER was scaled down once removed from pg_dist_node"
  else
    fail "SGCluster $ROUTER_CLUSTER was not scaled down once removed from pg_dist_node"
  fi

  # A stale query router would make Citus reject the addition of any node
  set_query_routers 2
  wait_query_router_registered "$ROUTER_CLUSTER" "$ROUTER_GROUP"

  if run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 -d citus \
    -q "SELECT COUNT(*) FROM pg_dist_placement
      JOIN pg_dist_shard USING (shardid) JOIN pg_dist_partition USING (logicalrelid)
      WHERE groupid > 1024 AND partmethod <> 'n'" | grep -xF 0
  then
    success "Query routers do not hold shards of distributed tables"
  else
    fail "Query routers hold shards of distributed tables"
  fi
}

set_query_routers() {
  kubectl patch sgshardedcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" --type merge \
    -p '{"spec":{"coordinator":{"queryRouterClusters":'"$1"'}}}'
}

wait_query_router_registered() {
  local ROUTER_CLUSTER="$1"
  local ROUTER_GROUP="$2"

  if try_function wait_until eval '[ "$(kubectl get pod -n "$CLUSTER_NAMESPACE" \
      "$ROUTER_CLUSTER-0" --template "{{ .status.phase }}" 2>/dev/null)" = Running ]' \
    && "$RESULT"
  then
    success "Query router pod $ROUTER_CLUSTER-0 is Running"
  else
    fail "Query router pod $ROUTER_CLUSTER-0 did not reach Running phase"
  fi

  try_function wait_until eval 'run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 \
    -d citus -q "SELECT COUNT(*) FROM pg_dist_node WHERE groupid = $ROUTER_GROUP
      AND noderole = '"'primary'"' AND isactive AND hasmetadata AND NOT shouldhaveshards" | grep -xF 1'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Query router of group $ROUTER_GROUP is registered in pg_dist_node without shards"
  else
    fail "Query router of group $ROUTER_GROUP is not registered in pg_dist_node without shards"
  fi

  try_function wait_until eval 'run_query -c "$CLUSTER_NAME-coord" -h "$CLUSTER_NAME" -i 1 -p 5432 \
    -d citus -q "SELECT COUNT(*) FROM pg_dist_partition
      WHERE partmethod = '"'n'"' AND repmodel = '"'t'"'
      AND NOT EXISTS (SELECT FROM pg_dist_shard JOIN pg_dist_placement USING (shardid)
        WHERE pg_dist_shard.logicalrelid = pg_dist_partition.logicalrelid
        AND pg_dist_placement.groupid = $ROUTER_GROUP)" | grep -xF 0'

  if [ "$EXIT_CODE" = 0 ]
  then
    success "Query router of group $ROUTER_GROUP holds the reference tables"
  else
    fail "Query router of group $ROUTER_GROUP does not hold the reference tables"
  fi

  # Patroni of the query router is only started once the SGShardedCluster set the start gate annotation
  if [ "$(kubectl get sgcluster -n "$CLUSTER_NAMESPACE" "$ROUTER_CLUSTER" \
    --template '{{ index .spec.configurations.patroni.startGateAnnotations "stackgres.io/citus-group-registered" }}')" = "$ROUTER_GROUP" ] \
    && [ "$(kubectl get sgcluster -n "$CLUSTER_NAMESPACE" "$ROUTER_CLUSTER" \
    --template '{{ index .metadata.annotations "stackgres.io/citus-group-registered" }}')" = "$ROUTER_GROUP" ]
  then
    success "SGCluster $ROUTER_CLUSTER has the start gate annotation set by the SGShardedCluster"
  else
    fail "SGCluster $ROUTER_CLUSTER does not have the start gate annotation set by the SGShardedCluster"
  fi
}
