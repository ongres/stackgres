#!/bin/sh

E2E_PLAYWRIGHT_VERSION="${E2E_PLAYWRIGHT_VERSION:-1.64.1}"

e2e_exclusive_lock() {
  true
}

e2e_test_extra_hash() {
  "$SHELL" "$PROJECT_PATH/stackgres-k8s/ci/build/build-functions.sh" path_hash \
    "$(realpath --relative-to "$PROJECT_PATH" "$PROJECT_PATH/stackgres-k8s/src/admin-ui/react/e2e-live")"
  "$SHELL" "$PROJECT_PATH/stackgres-k8s/ci/build/build-functions.sh" path_hash \
    "$(realpath --relative-to "$PROJECT_PATH" "$PROJECT_PATH/stackgres-k8s/src/admin-ui/react/playwright-live.config.js")"
  echo "E2E_UI_POSTGRES_VERSION=$E2E_UI_POSTGRES_VERSION"
  echo "E2E_PLAYWRIGHT_VERSION=$E2E_PLAYWRIGHT_VERSION"
}

e2e_test_install() {
  if [ "$(uname -m)" != x86_64 ]
  then
    return
  fi

  E2E_UI_POSTGRES_VERSION="${E2E_UI_POSTGRES_VERSION:-$E2E_POSTGRES_VERSION}"

  k8s_cleanup_namespace "$OPERATOR_NAMESPACE"
  k8s_async_cleanup

  install_prometheus_operator

  kubectl create namespace "$OPERATOR_NAMESPACE"
  install_operator_only \
    --set adminui.service.exposeHTTP=true \
    --set grafana.autoEmbed=true \
    --set-string grafana.webHost="prometheus-grafana.$(prometheus_namespace)"

  kubectl delete clusterrolebinding stackgres-restapi-admin-full --ignore-not-found
  kubectl create clusterrolebinding stackgres-restapi-admin-full --user=admin --clusterrole=cluster-admin

  kubectl create namespace "$CLUSTER_NAMESPACE"

  create_or_replace_cluster "$CLUSTER_NAME" "$CLUSTER_NAMESPACE" 2 \
    --set-string "cluster.postgres.version=$E2E_UI_POSTGRES_VERSION"

  local PASSWORD
  PASSWORD="$(kubectl get secrets -n "$OPERATOR_NAMESPACE" stackgres-restapi-admin -o jsonpath="{.data.clearPassword}" | base64 -d)"
  PLAYWRIGHT_POD="playwright"

  cat << EOF | kubectl apply -f -
  apiVersion: v1
  kind: Pod
  metadata:
    name: $PLAYWRIGHT_POD
    namespace: $CLUSTER_NAMESPACE
  spec:
    containers:
    - name: $PLAYWRIGHT_POD
      image: mcr.microsoft.com/playwright:v$E2E_PLAYWRIGHT_VERSION-noble
      command: [ "sh", "-c", "while true; do sleep 300; done" ]
      imagePullPolicy: IfNotPresent
      workingDir: /tests
      env:
      - name: PLAYWRIGHT_BASE_URL
        value: "https://stackgres-restapi.$OPERATOR_NAMESPACE/admin"
      - name: PLAYWRIGHT_TIMEOUT
        value: "$((E2E_TIMEOUT * 1000))"
      - name: LIVE_USERNAME
        value: "admin"
      - name: LIVE_PASSWORD
        value: "$PASSWORD"
      - name: LIVE_NAMESPACE
        value: "$CLUSTER_NAMESPACE"
      - name: LIVE_CLUSTER
        value: "$CLUSTER_NAME"
    restartPolicy: Always
    terminationGracePeriodSeconds: 0
EOF

  wait_pods_running "$CLUSTER_NAMESPACE" 4
  wait_cluster "$CLUSTER_NAME" "$CLUSTER_NAMESPACE"

  kubectl exec -i -n "$CLUSTER_NAMESPACE" "$PLAYWRIGHT_POD" -- mkdir -p /tests
  kubectl cp "$UI_TESTS_RESOURCES_PATH/react/e2e-live" "$CLUSTER_NAMESPACE/$PLAYWRIGHT_POD":/tests/e2e-live
  kubectl cp "$UI_TESTS_RESOURCES_PATH/react/playwright-live.config.js" "$CLUSTER_NAMESPACE/$PLAYWRIGHT_POD":/tests/playwright-live.config.js
  kubectl exec -i -n "$CLUSTER_NAMESPACE" "$PLAYWRIGHT_POD" -- \
    sh -c "cd /tests && npm init -y > /dev/null && npm install --no-audit --no-fund @playwright/test@$E2E_PLAYWRIGHT_VERSION"
}

e2e_test_uninstall() {
  helm_cleanup_chart "$CLUSTER_NAME" "$CLUSTER_NAMESPACE"

  k8s_async_cleanup_namespace "$CLUSTER_NAMESPACE"

  kubectl delete clusterrolebinding stackgres-restapi-admin-full --ignore-not-found
}

e2e_test_values() {
  (
  cd "$UI_TESTS_RESOURCES_PATH/react/e2e-live"
  find . -name '*.spec.js' | cut -d / -f 2- | sort
  )
}

e2e_test() {
  if [ "$(uname -m)" != x86_64 ]
  then
    echo "Skipping ui test since not running in x86_64 architecture"
    return
  fi

  run_test "Playwright chromium tests $SPEC_VALUE should pass" playwright_test

  run_test "Nginx must return the index page when a resource is not found" check_index_on_not_found_resource

  run_test "Nginx must work correctly on HTTP port when HTTP is exposed" check_http_port
}

playwright_test(){
  if ! kubectl exec -i -n "$CLUSTER_NAMESPACE" "$PLAYWRIGHT_POD" -- \
    sh -c "cd /tests && npx playwright test --config playwright-live.config.js e2e-live/$SPEC_VALUE"
  then
    kubectl cp -n "$CLUSTER_NAMESPACE" "$PLAYWRIGHT_POD":'/tests/test-results' "$LOG_PATH/playwright-results" || true
    exit 1
  fi
}

check_index_on_not_found_resource(){
  RANDOM_RESOURCE="$(random_string_lowercase 8)"
  HTTP_STATUS="$(kubectl exec -i -n "$CLUSTER_NAMESPACE" "$PLAYWRIGHT_POD" -- curl -s -k "https://stackgres-restapi.$OPERATOR_NAMESPACE/admin/$RANDOM_RESOURCE" -X GET -LI -o /dev/null -w '%{http_code}' 2>/dev/null)"

  assert_string_equal "200" "$HTTP_STATUS"

  HTTP_RESPONSE="$(kubectl exec -i -n "$CLUSTER_NAMESPACE" "$PLAYWRIGHT_POD" -- curl -s -k "https://stackgres-restapi.$OPERATOR_NAMESPACE/admin/$RANDOM_RESOURCE" -X GET -L 2>/dev/null)"

  if echo "$HTTP_RESPONSE" | grep -E "<meta.+index" > /dev/null
  then
    success "Returned index page on not found resource"
  else
    fail "Index page not returned on not found resource"
  fi
}

check_http_port(){
  HTTP_STATUS="$(kubectl exec -i -n "$CLUSTER_NAMESPACE" "$PLAYWRIGHT_POD" -- curl -s "http://stackgres-restapi.$OPERATOR_NAMESPACE/admin" -X GET -LI -o /dev/null -w '%{http_code}' 2>/dev/null)"

  if [ "$HTTP_STATUS" = "200" ]
  then
    success "HTTP port is working when exposed"
  else
    fail "HTTP port is not working when exposed"
  fi
}
