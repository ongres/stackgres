#!/bin/sh

# The changes of the usernames and passwords of SGCluster.spec.configurations.credentials, applied
# by changing the content of the referenced Secret or by referencing another Secret.

e2e_test_install() {
  kubectl create namespace "$CLUSTER_NAMESPACE"

  create_credentials_secret "$CLUSTER_NAME-credentials-a" \
    superuser-username=postgres \
    superuser-password="$(new_password)" \
    replication-username=replicator \
    replication-password="$(new_password)" \
    authenticator-username=authenticator \
    authenticator-password="$(new_password)" \
    monitor-username=monitor \
    monitor-password="$(new_password)" \
    restapi-password="$(new_password)"

  create_or_replace_cluster "$CLUSTER_NAME" "$CLUSTER_NAMESPACE" 2 \
    --set instanceProfiles[0].name=size-s \
    --set instanceProfiles[0].cpu=250m \
    --set instanceProfiles[0].memory=512Mi \
    --set credentials=null \
    $(credentials_helm_args "$CLUSTER_NAME-credentials-a")

  wait_pods_running "$CLUSTER_NAMESPACE" 2
  wait_cluster "$CLUSTER_NAME" "$CLUSTER_NAMESPACE"
  switch_cluster_to_first "$CLUSTER_NAME" "$CLUSTER_NAMESPACE"

  generate_mock_data "$CLUSTER_NAME"
  check_mock_data_samehost "$CLUSTER_NAME"
  wait_until check_mock_data_replication "$CLUSTER_NAME"
}

e2e_test() {
  run_test "Checking that changing the passwords in the referenced Secret is applied to the users" \
    check_passwords_change_in_secret

  run_test "Checking that referencing another Secret with other passwords is applied to the users" \
    check_passwords_change_with_another_secret

  run_test "Checking that changing the username of the authenticator user creates it and PgBouncer uses it" \
    check_authenticator_username_change

  run_test "Checking that changing the username of the monitor user creates it and the Postgres exporter uses it without a restart" \
    check_monitor_username_change

  run_test "Checking that the Postgres exporter can collect all the metrics with a renamed monitor user" \
    check_monitor_username_change_grants

  run_test "Checking that changing the username of the superuser and of the replication user is applied when the users were created before" \
    check_superuser_and_replication_username_change_with_existing_roles

  run_test "Checking that the former primary follows the new primary after a switchover that follows a change of the superuser and replication passwords" \
    check_switchover_after_passwords_change

  run_test "Checking that changing the password of the Patroni REST API is applied to Patroni" \
    check_restapi_password_change

  run_test "Checking that changing the username of the replication user creates it" \
    check_replication_username_change

  run_test "Checking that changing the username of the superuser creates it" \
    check_superuser_username_change
}

check_passwords_change_in_secret() {
  local SECRET
  SECRET="$(get_credentials_secret)"
  local USER
  local OLD_PASSWORDS=""
  for USER in superuser replication authenticator monitor
  do
    OLD_PASSWORDS="$OLD_PASSWORDS $USER=$(get_secret_value "$SECRET" "$USER-password")"
  done

  set_secret_values "$SECRET" \
    superuser-password="$(new_password)" \
    replication-password="$(new_password)" \
    authenticator-password="$(new_password)" \
    monitor-password="$(new_password)"

  check_passwords_applied "$SECRET" "$OLD_PASSWORDS"
}

check_passwords_change_with_another_secret() {
  local OLD_SECRET
  OLD_SECRET="$(get_credentials_secret)"
  local USER
  local OLD_PASSWORDS=""
  for USER in superuser replication authenticator monitor
  do
    OLD_PASSWORDS="$OLD_PASSWORDS $USER=$(get_secret_value "$OLD_SECRET" "$USER-password")"
  done

  create_credentials_secret "$CLUSTER_NAME-credentials-b" \
    superuser-username="$(get_secret_value "$OLD_SECRET" superuser-username)" \
    superuser-password="$(new_password)" \
    replication-username="$(get_secret_value "$OLD_SECRET" replication-username)" \
    replication-password="$(new_password)" \
    authenticator-username="$(get_secret_value "$OLD_SECRET" authenticator-username)" \
    authenticator-password="$(new_password)" \
    monitor-username="$(get_secret_value "$OLD_SECRET" monitor-username)" \
    monitor-password="$(new_password)" \
    restapi-password="$(get_secret_value "$OLD_SECRET" restapi-password)"

  kubectl patch sgcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" --type merge \
    -p "$(credentials_patch "$CLUSTER_NAME-credentials-b")"

  check_passwords_applied "$CLUSTER_NAME-credentials-b" "$OLD_PASSWORDS"
}

check_passwords_applied() {
  local SECRET="$1"
  local OLD_PASSWORDS="$2"
  local USER
  local USERNAME
  local PASSWORD
  local OLD_PASSWORD

  for USER in superuser authenticator monitor
  do
    USERNAME="$(get_secret_value "$SECRET" "$USER-username")"
    PASSWORD="$(get_secret_value "$SECRET" "$USER-password")"
    OLD_PASSWORD="$(printf '%s' "$OLD_PASSWORDS" | tr ' ' '\n' | sed -n "s/^$USER=//p")"
    if wait_until login "$USERNAME" "$PASSWORD"
    then
      success "The new password of the $USER user $USERNAME was applied"
    else
      fail "The new password of the $USER user $USERNAME was not applied"
    fi
    if login "$USERNAME" "$OLD_PASSWORD"
    then
      fail "The previous password of the $USER user $USERNAME is still accepted"
    else
      success "The previous password of the $USER user $USERNAME is rejected"
    fi
  done

  USERNAME="$(get_secret_value "$SECRET" replication-username)"
  PASSWORD="$(get_secret_value "$SECRET" replication-password)"
  OLD_PASSWORD="$(printf '%s' "$OLD_PASSWORDS" | tr ' ' '\n' | sed -n "s/^replication=//p")"
  if wait_until replication_login "$USERNAME" "$PASSWORD"
  then
    success "The new password of the replication user $USERNAME was applied"
  else
    fail "The new password of the replication user $USERNAME was not applied"
  fi
  if replication_login "$USERNAME" "$OLD_PASSWORD"
  then
    fail "The previous password of the replication user $USERNAME is still accepted"
  else
    success "The previous password of the replication user $USERNAME is rejected"
  fi

  check_metrics_up
  check_cluster_replicates
}

check_authenticator_username_change() {
  local SECRET
  SECRET="$(get_credentials_secret)"
  local PASSWORD
  PASSWORD="$(get_secret_value "$SECRET" authenticator-password)"

  set_secret_values "$SECRET" authenticator-username=authenticator2

  if wait_until login authenticator2 "$PASSWORD"
  then
    success "The authenticator user authenticator2 was created"
  else
    fail "The authenticator user authenticator2 was not created"
  fi

  if wait_until eval 'kubectl exec -n "$CLUSTER_NAMESPACE" "$(get_cluster_primary)" -c pgbouncer -- \
    grep -q "^auth_user = authenticator2$" /etc/pgbouncer/pgbouncer.ini'
  then
    success "PgBouncer uses the authenticator user authenticator2"
  else
    fail "PgBouncer does not use the authenticator user authenticator2"
  fi

  # A user that is not in the PgBouncer auth file is authenticated with the authenticator user
  run_query -i "$(get_primary_index)" -p 5432 \
    -q "DROP ROLE IF EXISTS credentials_check; CREATE ROLE credentials_check WITH LOGIN PASSWORD 'credentials_check';"
  if wait_until run_query -i "$(get_primary_index)" -p 6432 -u credentials_check:credentials_check -q 'SELECT 1'
  then
    success "A user can connect through PgBouncer with the authenticator user authenticator2"
  else
    fail "A user can not connect through PgBouncer with the authenticator user authenticator2"
  fi
}

check_monitor_username_change() {
  local SECRET
  SECRET="$(get_credentials_secret)"
  local PASSWORD
  PASSWORD="$(get_secret_value "$SECRET" monitor-password)"
  local PODS_CREATION_TIMESTAMPS
  PODS_CREATION_TIMESTAMPS="$(get_pods_creation_timestamps)"

  set_secret_values "$SECRET" monitor-username=monitor2

  if wait_until login monitor2 "$PASSWORD"
  then
    success "The monitor user monitor2 was created"
  else
    fail "The monitor user monitor2 was not created"
  fi

  if wait_until eval '[ "$(get_postgres_exporter_users)" = monitor2 ]'
  then
    success "The Postgres exporter uses the monitor user monitor2"
  else
    fail "The Postgres exporter does not use the monitor user monitor2"
  fi

  check_metrics_up

  if [ "$(get_pods_creation_timestamps)" = "$PODS_CREATION_TIMESTAMPS" ] \
    && [ "$(kubectl get sgcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" \
      --template '{{ range .status.conditions }}{{ if eq .type "PendingRestart" }}{{ .status }}{{ end }}{{ end }}')" = False ]
  then
    success "The Pods were not restarted after changing the username of the monitor user"
  else
    fail "The Pods were restarted or require a restart after changing the username of the monitor user"
  fi
}

check_monitor_username_change_grants() {
  # The metric is collected with functions that the Postgres exporter can only execute if granted
  if wait_until eval 'get_metrics | grep -q "^node_filesystem_size_bytes{"'
  then
    success "The Postgres exporter collects the metrics that require grants with the monitor user monitor2"
  else
    fail "The Postgres exporter does not collect the metrics that require grants with the monitor user monitor2 (see #3305)"
  fi
}

check_superuser_and_replication_username_change_with_existing_roles() {
  local SECRET
  SECRET="$(get_credentials_secret)"
  local SUPERUSER_PASSWORD
  SUPERUSER_PASSWORD="$(get_secret_value "$SECRET" superuser-password)"
  local REPLICATION_PASSWORD
  REPLICATION_PASSWORD="$(get_secret_value "$SECRET" replication-password)"

  # As documented in the description of SGCluster.spec.configurations.credentials.users
  run_query -i "$(get_primary_index)" -p 5432 \
    -q "CREATE ROLE postgres2 WITH SUPERUSER INHERIT CREATEROLE CREATEDB LOGIN REPLICATION BYPASSRLS;
      CREATE ROLE replicator2 WITH NOSUPERUSER INHERIT NOCREATEROLE NOCREATEDB LOGIN REPLICATION NOBYPASSRLS;"

  set_secret_values "$SECRET" \
    superuser-username=postgres2 \
    replication-username=replicator2

  if wait_until login postgres2 "$SUPERUSER_PASSWORD"
  then
    success "The password of the superuser postgres2 was applied"
  else
    fail "The password of the superuser postgres2 was not applied"
  fi

  if wait_until replication_login replicator2 "$REPLICATION_PASSWORD"
  then
    success "The password of the replication user replicator2 was applied"
  else
    fail "The password of the replication user replicator2 was not applied"
  fi

  # The changes that follow are applied connecting with the new superuser
  local AUTHENTICATOR_PASSWORD
  AUTHENTICATOR_PASSWORD="$(new_password)"
  set_secret_values "$SECRET" authenticator-password="$AUTHENTICATOR_PASSWORD"
  if wait_until login "$(get_secret_value "$SECRET" authenticator-username)" "$AUTHENTICATOR_PASSWORD"
  then
    success "The credentials changes are applied after changing the username of the superuser"
  else
    fail "The credentials changes are not applied after changing the username of the superuser"
  fi

  # Patroni of the replica is reloaded with the new replication user, that it uses to replicate
  if wait_until eval '[ "$(run_query -i "$(get_primary_index)" -p 5432 \
    -q "SELECT DISTINCT usename FROM pg_stat_replication")" = replicator2 ]'
  then
    success "The replica replicates with the replication user replicator2"
  else
    fail "The replica does not replicate with the replication user replicator2"
  fi

  check_cluster_replicates
}

check_restapi_password_change() {
  local SECRET
  SECRET="$(get_credentials_secret)"
  local OLD_PASSWORD
  OLD_PASSWORD="$(get_secret_value "$SECRET" restapi-password)"
  local PASSWORD
  PASSWORD="$(new_password)"

  set_secret_values "$SECRET" restapi-password="$PASSWORD"

  wait_until eval '[ "$(get_secret_value "$CLUSTER_NAME" restapi-password)" = "$PASSWORD" ]'

  if wait_until eval '[ "$(restapi_reload "$PASSWORD")" = 202 ]'
  then
    success "The new password of the Patroni REST API was applied"
  else
    fail "The new password of the Patroni REST API was not applied (see #3301)"
  fi
  if [ "$(restapi_reload "$OLD_PASSWORD")" = 401 ]
  then
    success "The previous password of the Patroni REST API is rejected"
  else
    fail "The previous password of the Patroni REST API is still accepted (see #3301)"
  fi
}

check_switchover_after_passwords_change() {
  local SECRET
  SECRET="$(get_credentials_secret)"
  local SUPERUSER_PASSWORD
  SUPERUSER_PASSWORD="$(new_password)"
  local REPLICATION_PASSWORD
  REPLICATION_PASSWORD="$(new_password)"

  set_secret_values "$SECRET" \
    superuser-password="$SUPERUSER_PASSWORD" \
    replication-password="$REPLICATION_PASSWORD"

  wait_until login "$(get_secret_value "$SECRET" superuser-username)" "$SUPERUSER_PASSWORD"
  wait_until replication_login "$(get_secret_value "$SECRET" replication-username)" "$REPLICATION_PASSWORD"

  local PRIMARY
  PRIMARY="$(get_cluster_primary)"
  local REPLICA
  REPLICA="$(get_cluster_pods | tr ' ' '\n' | grep -v "^$PRIMARY$" | grep .)"
  kubectl exec -n "$CLUSTER_NAMESPACE" "$PRIMARY" -c patroni -- \
    patronictl switchover "$CLUSTER_NAME" --candidate "$REPLICA" --force
  if wait_until eval '[ "$(get_cluster_primary)" = "$REPLICA" ]'
  then
    success "The switchover to $REPLICA was performed"
  else
    fail "The switchover to $REPLICA was not performed"
  fi

  if wait_until -t "$((E2E_TIMEOUT * 2))" eval 'is_member_streaming "$PRIMARY"' \
    && check_replica_has_new_data "$PRIMARY"
  then
    success "The former primary $PRIMARY follows the new primary $REPLICA"
  else
    fail "The former primary $PRIMARY does not follow the new primary $REPLICA (see #3301)"
  fi
}

check_replication_username_change() {
  local SECRET
  SECRET="$(get_credentials_secret)"
  local AUTHENTICATOR_PASSWORD
  AUTHENTICATOR_PASSWORD="$(new_password)"

  set_secret_values "$SECRET" \
    replication-username=replicator3 \
    authenticator-password="$AUTHENTICATOR_PASSWORD"

  if wait_until replication_login replicator3 "$(get_secret_value "$SECRET" replication-password)"
  then
    success "The replication user replicator3 was created"
  else
    fail_no_return "The replication user replicator3 was not created (see #3304)"
  fi

  if wait_until login "$(get_secret_value "$SECRET" authenticator-username)" "$AUTHENTICATOR_PASSWORD"
  then
    success "The credentials changes that follow the change of the username of the replication user are applied"
  else
    fail "The credentials changes that follow the change of the username of the replication user are not applied (see #3304)"
  fi
}

check_superuser_username_change() {
  local SECRET
  SECRET="$(get_credentials_secret)"
  local MONITOR_PASSWORD
  MONITOR_PASSWORD="$(new_password)"

  set_secret_values "$SECRET" \
    superuser-username=postgres3 \
    monitor-password="$MONITOR_PASSWORD"

  if wait_until login postgres3 "$(get_secret_value "$SECRET" superuser-password)"
  then
    success "The superuser postgres3 was created"
  else
    fail_no_return "The superuser postgres3 was not created (see #3304)"
  fi

  if wait_until login "$(get_secret_value "$SECRET" monitor-username)" "$MONITOR_PASSWORD"
  then
    success "The credentials changes that follow the change of the username of the superuser are applied"
  else
    fail "The credentials changes that follow the change of the username of the superuser are not applied (see #3304)"
  fi
}

new_password() {
  head -c 18 /dev/urandom | base64 | tr -dc 'A-Za-z0-9'
}

create_credentials_secret() {
  local SECRET="$1"
  shift
  local LITERAL
  kubectl create secret generic -n "$CLUSTER_NAMESPACE" "$SECRET" \
    $(for LITERAL in "$@"; do printf ' --from-literal=%s' "$LITERAL"; done)
}

set_secret_values() {
  local SECRET="$1"
  shift
  local LITERAL
  kubectl patch secret -n "$CLUSTER_NAMESPACE" "$SECRET" --type merge \
    -p "$(for LITERAL in "$@"; do printf '%s\n' "$LITERAL"; done \
      | jq -R -s 'split("\n") | map(select(. != "") | capture("^(?<key>[^=]+)=(?<value>.*)$"))
        | {stringData: from_entries}')"
}

get_secret_value() {
  local SECRET="$1"
  local KEY="$2"
  kubectl get secret -n "$CLUSTER_NAMESPACE" "$SECRET" \
    --template "{{ index .data \"$KEY\" | base64decode }}"
}

get_credentials_secret() {
  kubectl get sgcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" \
    --template '{{ .spec.configurations.credentials.users.superuser.password.name }}'
}

credentials_helm_args() {
  local SECRET="$1"
  local USER
  local FIELD
  for USER in superuser replication authenticator monitor
  do
    for FIELD in username password
    do
      printf ' --set-string cluster.configurations.credentials.users.%s.%s.name=%s' "$USER" "$FIELD" "$SECRET"
      printf ' --set-string cluster.configurations.credentials.users.%s.%s.key=%s-%s' "$USER" "$FIELD" "$USER" "$FIELD"
    done
  done
  printf ' --set-string cluster.configurations.credentials.patroni.restApiPassword.name=%s' "$SECRET"
  printf ' --set-string cluster.configurations.credentials.patroni.restApiPassword.key=restapi-password'
}

credentials_patch() {
  local SECRET="$1"
  jq -n --arg secret "$SECRET" '{
      spec: {
        configurations: {
          credentials: {
            patroni: { restApiPassword: { name: $secret, key: "restapi-password" } },
            users: (["superuser", "replication", "authenticator", "monitor"]
              | map({
                key: .,
                value: {
                  username: { name: $secret, key: (. + "-username") },
                  password: { name: $secret, key: (. + "-password") }
                }
              })
              | from_entries)
          }
        }
      }
    }'
}

# Connects over TCP to the primary, so that the password is checked
login() {
  local USERNAME="$1"
  local PASSWORD="$2"
  run_query -i "$(get_primary_index)" -p 5432 -u "$USERNAME:$PASSWORD" -q 'SELECT 1' > /dev/null 2>&1
}

replication_login() {
  local USERNAME="$1"
  local PASSWORD="$2"
  kubectl exec -n "$CLUSTER_NAMESPACE" "$(get_cluster_primary)" -c postgres-util -- \
    env PGPASSWORD="$PASSWORD" PGCONNECT_TIMEOUT="$((5 + E2E_TIMEOUT / 10))" \
    psql "host=127.0.0.1 port=5432 user=$USERNAME dbname=postgres replication=database" \
    -q -t -A -c 'IDENTIFY_SYSTEM' > /dev/null 2>&1
}

restapi_reload() {
  local PASSWORD="$1"
  kubectl exec -n "$CLUSTER_NAMESPACE" "$(get_cluster_primary)" -c patroni -- \
    curl -s -o /dev/null -w '%{http_code}' -u "superuser:$PASSWORD" -X POST http://localhost:8009/reload
}

get_metrics() {
  kubectl exec -n "$CLUSTER_NAMESPACE" "$(get_cluster_primary)" -c patroni -- \
    curl -s http://localhost:9187/metrics
}

# The users the Postgres exporter is connected with, that connects when the metrics are collected
get_postgres_exporter_users() {
  get_metrics > /dev/null
  run_query -i "$(get_primary_index)" -p 5432 \
    -q "SELECT DISTINCT usename FROM pg_stat_activity
      WHERE application_name = 'prometheus-postgres-exporter'"
}

check_metrics_up() {
  if wait_until eval 'get_metrics | grep -q "^pg_up{.*} 1$"'
  then
    success "The Postgres exporter connects to Postgres"
  else
    fail "The Postgres exporter does not connect to Postgres"
  fi
}

is_member_streaming() {
  local MEMBER="$1"
  kubectl exec -n "$CLUSTER_NAMESPACE" "$(get_cluster_primary)" -c patroni -- patronictl list -f json \
    | jq -e --arg member "$MEMBER" '.[] | select(.Member == $member and .State == "streaming")' > /dev/null
}

check_cluster_replicates() {
  local PRIMARY
  PRIMARY="$(get_cluster_primary)"
  local REPLICA
  REPLICA="$(get_cluster_pods | tr ' ' '\n' | grep -v "^$PRIMARY$" | grep .)"
  if wait_until eval 'is_member_streaming "$REPLICA"' \
    && check_replica_has_new_data "$REPLICA"
  then
    success "The replica $REPLICA follows the primary $PRIMARY"
  else
    fail "The replica $REPLICA does not follow the primary $PRIMARY"
  fi
}

# Writes a new value on the primary and waits for the replica to have it
check_replica_has_new_data() {
  local REPLICA="$1"
  local VALUE
  VALUE="$(new_password)"
  run_query -i "$(get_primary_index)" -p 5432 \
    -q "CREATE TABLE IF NOT EXISTS credentials_check (value text); INSERT INTO credentials_check VALUES ('$VALUE');"
  wait_until eval '[ "$(run_query -i "${REPLICA##*-}" -p 5432 \
    -q "SELECT count(*) FROM credentials_check WHERE value = '"'"'$VALUE'"'"'")" = 1 ]'
}
