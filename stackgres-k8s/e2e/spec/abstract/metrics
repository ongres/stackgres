#!/bin/sh

check_metrics() {
  local CLUSTER_NAME="${1:-$CLUSTER_NAME}"
  local CLUSTER_POD_IP

  CLUSTER_POD_IP="$(kubectl get pod -n "$CLUSTER_NAMESPACE" \
    -l "app=StackGresCluster,stackgres.io/cluster-name=$CLUSTER_NAME,stackgres.io/cluster=true" \
    -o=jsonpath='{ .items[].status.podIP }')"
  CLUSTER_POD_IP="$(printf %s "$CLUSTER_POD_IP" | head -n 1)"
  for METRIC in pg_settings_shared_buffers_bytes pg_stat_activity_count node_filesystem_size_bytes \
    pgbouncer_show_stats_total_query_count pg_table_bloat_real_size
  do
    if wait_until eval 'kubectl exec -i -n "$CLUSTER_NAMESPACE" curl \
          -- curl -s -f "http://$CLUSTER_POD_IP:9187/metrics" \
          | grep -q "^$METRIC"'
    then
      echo "Exporter metric $METRIC was found"
    else
      echo "Exporter metric $METRIC wasn't found"
    fi
  done

  if ! kubectl get sgcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" --template '{{ .spec.pods.disableEnvoy }}' | grep -qxF true
  then
    if kubectl exec -i -n "$CLUSTER_NAMESPACE" curl \
      -- curl -s -f "http://$CLUSTER_POD_IP:8001/stats/prometheus" \
      | grep -q "^envoy_postgres_ingress_postgres_sessions"
    then
      echo "Envoy metric envoy_postgres_ingress_postgres_sessions was found"
    else
      echo "Envoy metric envoy_postgres_ingress_postgres_sessions wasn't found"
      return 1
    fi

    for ENVOY_CLUSTER in patroni_cluster postgres_cluster postgres_cluster_pool
    do
      if kubectl exec -i -n "$CLUSTER_NAMESPACE" curl \
        -- curl -s -f "http://$CLUSTER_POD_IP:8001/stats/prometheus" \
        | grep "^envoy_cluster_upstream_cx_active" \
        | grep -q "envoy_cluster_name=\"$ENVOY_CLUSTER\""
      then
        echo "Envoy metric envoy_cluster_upstream_cx_active for cluster $ENVOY_CLUSTER was found"
      else
        echo "Envoy metric envoy_cluster_upstream_cx_active for cluster $ENVOY_CLUSTER wasn't found"
        return 1
      fi
    done
  fi
}

# The pod is looked up on each attempt and not once before awaiting: the deployment is rolled out
# again while the test runs (by OLM, or by the operator itself when the grafana integration fills
# the status of the SGConfig), so a pod name looked up once is the name of a pod that is already
# terminating and every attempt after that fails with "not found" until the timeout is reached.
check_operator_metrics() {
  local NAMESPACE="${1:-$OPERATOR_NAMESPACE}"

  if wait_until eval 'OPERATOR_POD="$(kubectl get pod -n "$NAMESPACE" -l app=stackgres-operator \
      --field-selector status.phase=Running -o name | head -n 1)" \
      && [ -n "$OPERATOR_POD" ] \
      && kubectl exec -n "$NAMESPACE" "$OPERATOR_POD" \
      -- curl -s http://localhost:8080/q/metrics \
      | grep -q "^sg_operator_reconciliation_total_performed{resource=\"sgconfig\"}"'
  then
    success "The operator exposes the reconciliation metrics"
  else
    fail "The operator does not expose the reconciliation metrics"
  fi
}

# The pod is looked up on each attempt for the same reason as in check_operator_metrics.
check_restapi_metrics() {
  local NAMESPACE="${1:-$OPERATOR_NAMESPACE}"

  if wait_until eval 'RESTAPI_POD="$(kubectl get pod -n "$NAMESPACE" -l stackgres.io/restapi=true \
      --field-selector status.phase=Running -o name | head -n 1)" \
      && [ -n "$RESTAPI_POD" ] \
      && kubectl exec -n "$NAMESPACE" "$RESTAPI_POD" -c stackgres-restapi \
      -- curl -s -k https://localhost:8443/stackgres/auth/type > /dev/null \
      && kubectl exec -n "$NAMESPACE" "$RESTAPI_POD" -c stackgres-restapi \
      -- curl -s -k https://localhost:8443/q/metrics \
      | grep -q "^http_server_requests_seconds_count{.*status=\"200\",uri=\"/stackgres/auth/type\"}"'
  then
    success "The REST API exposes the metrics of its requests"
  else
    fail "The REST API does not expose the metrics of its requests"
  fi
}

check_cluster_controller_metrics() {
  local CLUSTER_NAME="${1:-$CLUSTER_NAME}"
  local CLUSTER_NAMESPACE="${2:-$CLUSTER_NAMESPACE}"
  local PRIMARY_POD
  PRIMARY_POD="$(kubectl get pod -n "$CLUSTER_NAMESPACE" \
    -l "app=StackGresCluster,stackgres.io/cluster-name=$CLUSTER_NAME,role=primary" \
    --template '{{ range .items }}{{ .metadata.name }}{{ "\n" }}{{ end }}' | head -n 1)"

  # The counters of the executions of the SGScript entries only exist in the cluster-controller that
  # executed them and an SGScript entry without cron is only executed once (the Pods may have been
  # restarted since), so an SGScript is added to have one executed by the current primary
  cat << EOF | kubectl create -f -
apiVersion: stackgres.io/v1
kind: SGScript
metadata:
  namespace: $CLUSTER_NAMESPACE
  name: $CLUSTER_NAME-metrics
spec:
  scripts:
  - name: metrics-check
    script: SELECT 1
EOF
  kubectl patch sgcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" --type json \
    -p '[{"op":"add","path":"/spec/managedSql/scripts/-","value":{"sgScript":"'"$CLUSTER_NAME"'-metrics"}}]'

  for METRIC in \
    'sg_controller_reconciliation_total_performed{resource="sgcluster"}' \
    'sg_controller_reconciliation_total_performed{resource="sgcluster-managed-sql"}' \
    'sg_controller_managed_sql_script_entry_executions_total{id="0",script="metrics-check",sgscript="'"$CLUSTER_NAME"'-metrics"}'
  do
    if wait_until eval 'kubectl exec -n "$CLUSTER_NAMESPACE" "$PRIMARY_POD" -c cluster-controller \
        -- curl -s http://localhost:8080/q/metrics \
        | grep -q "^$METRIC"'
    then
      success "The cluster-controller exposes the metric $METRIC"
    else
      fail "The cluster-controller does not expose the metric $METRIC"
    fi
  done
}
