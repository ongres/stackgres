#!/bin/sh

# The SGDbOps of a member always completes before the SGShardedDbOps that created it, so it is
# waited for with the same extended timeout. A major version upgrade of a member keeps it down while
# the image of the target version and the one that performs the upgrade are pulled, which on its own
# takes longer than E2E_TIMEOUT.
wait_dbops_is_completed() {
  local DBOPS_NAME="$1"
  if wait_until -t "$((E2E_TIMEOUT * 4))" kubectl wait --timeout 0s sgdbops -n "$CLUSTER_NAMESPACE" "$DBOPS_NAME" \
    --for=condition=Completed > /dev/null
  then
    success "The dbops has completed"
  else
    fail "The dbops has failed or did not completed"
  fi
}

wait_sharded_dbops_is_completed() {
  local SHARDED_DBOPS_NAME="$1"
  if wait_until -t "$((E2E_TIMEOUT * 4))" kubectl wait --timeout 0s sgshardeddbops -n "$CLUSTER_NAMESPACE" "$SHARDED_DBOPS_NAME" \
    --for=condition=Completed > /dev/null
  then
    success "The sharded dbops has completed"
  else
    fail "The sharded dbops has failed or did not completed"
  fi
}

trigger_sharded_cluster_require_restart() {
  local DATE="$(date +%s)"
  kubectl patch sgshardedcluster -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" --type merge \
    -p "spec: { coordinator: { pods: { customEnv: { patroni: [{ name: REQUIRE_RESTART, value: '$DATE' }] } } } }"
  kubectl wait sts --timeout "${E2E_TIMEOUT}s" -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME-coord" \
    --for jsonpath='{.spec.template.spec.containers[?(@.name == "patroni")].env[?(@.name == "REQUIRE_RESTART")].value}'="$DATE"
}

# The postgres version a member runs can not be read from the images of its Pod: the images
# released with the operator put the postgres version in the tag of a single repository while the
# StackGres images repository builds a repository per component and version, so a version only
# appears in some of them and never with the same separators. The version reported by the server is
# checked instead, as the numeric server_version_num, since server_version is suffixed with the
# t-shirt size of the image by the StackGres images repository (`17.11full`).
check_sharded_members_postgres_version() {
  local VERSION="$1"
  local VERSION_NUM SUFFIX
  VERSION_NUM="$(( ${VERSION%%.*} * 10000 + ${VERSION#*.} ))"
  for SUFFIX in coord worker0 worker1
  do
    if [ "$(kubectl exec -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME-$SUFFIX-0" -c "postgres-util" -- \
      psql -q -t -A -d citus -c "SHOW server_version_num")" = "$VERSION_NUM" ]
    then
      success "Member $CLUSTER_NAME-$SUFFIX is running postgres $VERSION"
    else
      fail "Member $CLUSTER_NAME-$SUFFIX is not running postgres $VERSION"
    fi
  done
}
