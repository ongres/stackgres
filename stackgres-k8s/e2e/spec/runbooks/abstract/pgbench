#!/bin/sh

# Code shared by the pgbench runbooks.
#
# Each runbook benchmarks its cluster once per configured load step (100%, 150%
# and 200% of the base number of clients by default) so that the behaviour under
# increasing pressure can be compared.
#
# Three kinds of statistics are collected around those runs:
#
# * fio, once and before any benchmark starts, to measure what the disk backing
#   each Postgres data volume is able to deliver while otherwise idle, both with
#   a single request in flight and with a deep queue.
# * iostat, while each benchmark runs, to measure what the benchmark actually
#   asks from that same disk.
# * The checkpoint statistics Postgres writes to its log thanks to log_checkpoints.
#
# Both fio and iostat are run from a custom container declared in the SGCluster.
# Everything collected is presented as a single report at the end of the test.

# Scale factor of the benchmark. Large enough for the dataset, of roughly 15 MiB
# per unit, to exceed the memory of the instance profile: the read-only
# transactions only reach the disk once Postgres can no longer keep every page
# it reads in memory.
export E2E_PGBENCH_SCALE="${E2E_PGBENCH_SCALE:-200}"
export E2E_PGBENCH_CLIENTS="${E2E_PGBENCH_CLIENTS:-20}"
export E2E_PGBENCH_JOBS="${E2E_PGBENCH_JOBS:-20}"
# Weights of the read-write and of the read-only transactions of the benchmark.
# Four of the five statements of TPC-B write and its only select reads back the
# row the preceding update has just dirtied, so on its own it never reads a page
# it did not write first. Mixing in the select-only builtin gives the benchmark
# the share of read-only transactions an OLTP workload has. Set the read weight
# to 0 to benchmark with plain TPC-B, the write weight to 0 for reads only.
export E2E_PGBENCH_WRITE_WEIGHT="${E2E_PGBENCH_WRITE_WEIGHT:-1}"
export E2E_PGBENCH_READ_WEIGHT="${E2E_PGBENCH_READ_WEIGHT:-3}"
export E2E_PGBENCH_MAX_CONNECTIONS="${E2E_PGBENCH_MAX_CONNECTIONS:-104}"
export E2E_PGBENCH_DEFAULT_POOL_SIZE="${E2E_PGBENCH_DEFAULT_POOL_SIZE:-100}"
# Percentages of E2E_PGBENCH_CLIENTS and E2E_PGBENCH_JOBS to benchmark with. The
# benchmark is run once per step, in the given order, on the very same cluster.
export E2E_PGBENCH_LOAD_STEPS="${E2E_PGBENCH_LOAD_STEPS:-100 150 200}"
# Duration in seconds of each benchmark run. Half of the test timeout by default
# so that wait_until is still able to detect a run that does not terminate.
export E2E_PGBENCH_DURATION="${E2E_PGBENCH_DURATION:-}"
# Size of the disks backing the Postgres data volumes. The dataset of the default
# scale factor takes roughly 3 GiB and pg_wal up to the 2 GiB max_wal_size the
# operator configures, leaving enough room for the write-ahead log of the
# heaviest load step and for the disk to stay far from full, which would distort
# the very measurements the runbooks take.
export E2E_PGBENCH_DISK_SIZE="${E2E_PGBENCH_DISK_SIZE:-8Gi}"
export E2E_PGBENCH_DISK_BENCHMARK="${E2E_PGBENCH_DISK_BENCHMARK:-true}"
# IOPS and throughput (in MiB/s) to provision for the disks backing the Postgres
# data volumes. When any of them is set the cluster is created referencing a dedicated
# volume attributes class, which requires an environment able to generate it (see the
# generate_disk_performance_volume_attributes_class_k8s function of envs/eks) and a
# Kubernetes cluster serving the VolumeAttributesClass resource. An empty value leaves
# the corresponding setting to the default of the environment. Beware that a provider
# may limit both settings based on the volume size (an AWS gp3 volume, for instance,
# allows at most 500 IOPS per GiB and 0.25 MiB/s of throughput per IOPS), that is set
# with E2E_PGBENCH_DISK_SIZE.
export E2E_PGBENCH_DISK_IOPS="${E2E_PGBENCH_DISK_IOPS:-}"
export E2E_PGBENCH_DISK_THROUGHPUT="${E2E_PGBENCH_DISK_THROUGHPUT:-}"
# Neither the patroni nor the postgres-util image ship fio and iostat and the Pod
# runs unprivileged, so a dedicated image providing both tools is required.
export E2E_PGBENCH_DISK_BENCHMARK_IMAGE="${E2E_PGBENCH_DISK_BENCHMARK_IMAGE:-nixery.dev/shell/fio/sysstat:nixos-25.05}"
export E2E_PGBENCH_FIO_SIZE="${E2E_PGBENCH_FIO_SIZE:-32m}"
export E2E_PGBENCH_FIO_RUNTIME="${E2E_PGBENCH_FIO_RUNTIME:-10}"
# Percentage of reads of the mixed read/write fio job, the remainder being writes
export E2E_PGBENCH_FIO_RWMIXREAD="${E2E_PGBENCH_FIO_RWMIXREAD:-70}"
# Requests the deep queue fio jobs keep in flight and the asynchronous I/O engine
# they use to do so. Set the engine to io_uring, or to psync to give up on those
# jobs entirely, if the image does not provide libaio.
export E2E_PGBENCH_FIO_IODEPTH="${E2E_PGBENCH_FIO_IODEPTH:-32}"
export E2E_PGBENCH_FIO_IOENGINE="${E2E_PGBENCH_FIO_IOENGINE:-libaio}"
export E2E_PGBENCH_IOSTAT_INTERVAL="${E2E_PGBENCH_IOSTAT_INTERVAL:-1}"
# Number of iostat samples to take while a benchmark runs. Derived from the
# benchmark duration when left empty.
export E2E_PGBENCH_IOSTAT_COUNT="${E2E_PGBENCH_IOSTAT_COUNT:-}"

PGBENCH_DISK_BENCHMARK_CONTAINER=disk-benchmark
# Name the operator gives to a custom container (see StackGresContainer.CUSTOM)
PGBENCH_DISK_BENCHMARK_CONTAINER_NAME="custom-$PGBENCH_DISK_BENCHMARK_CONTAINER"
# Where the Postgres data volume is mounted (see ClusterPath.PG_BASE_PATH)
PGBENCH_DISK_BENCHMARK_MOUNT_PATH=/var/lib/postgresql
PGBENCH_DISK_BENCHMARK_PATH="$PGBENCH_DISK_BENCHMARK_MOUNT_PATH/fio"

PGBENCH_RULE='=================================================================================================='
PGBENCH_SUBRULE='-------------------------------------------------------------------------------------------------'

pgbench_extra_hash() {
  "$SHELL" "$PROJECT_PATH/stackgres-k8s/ci/build/build-functions.sh" path_hash \
    "$(realpath --relative-to "$PROJECT_PATH" "$SPEC_PATH/runbooks/abstract/pgbench")"
}

# Create the volume attributes class required by the requested disk performance before
# any cluster is created. A pgbench runbook defining e2e_test_before_all must call
# pgbench_init_disk_performance itself.
e2e_test_before_all() {
  pgbench_init_disk_performance
}

pgbench_init_disk_performance() {
  if [ -z "$E2E_PGBENCH_DISK_IOPS" ] && [ -z "$E2E_PGBENCH_DISK_THROUGHPUT" ]
  then
    return
  fi

  init_disk_performance_volume_attributes_class \
    "$E2E_PGBENCH_DISK_IOPS" "$E2E_PGBENCH_DISK_THROUGHPUT"
}

pgbench_duration() {
  printf %s "${E2E_PGBENCH_DURATION:-$((E2E_TIMEOUT / 2))}"
}

pgbench_load_steps() {
  printf %s "$E2E_PGBENCH_LOAD_STEPS"
}

# The builtin scripts the benchmark runs and their weights, to be passed to
# pgbench. A weight of 0 leaves the corresponding script out entirely, pgbench
# rejects a script weighted at 0.
pgbench_builtin_workload() {
  if [ "$E2E_PGBENCH_WRITE_WEIGHT" -gt 0 ]
  then
    printf '%s\n' --builtin "tpcb-like@$E2E_PGBENCH_WRITE_WEIGHT"
  fi
  if [ "$E2E_PGBENCH_READ_WEIGHT" -gt 0 ]
  then
    printf '%s\n' --builtin "select-only@$E2E_PGBENCH_READ_WEIGHT"
  fi
}

# Same as pgbench_builtin_workload but for a runbook whose schema needs scripts
# of its own, the first parameter being the read-write script and the second one
# the read-only one. Both are given a base weight of 100 so that such a runbook
# may keep weighting further scripts relatively to them.
pgbench_script_workload() {
  local WRITE_SCRIPT="$1"
  local READ_SCRIPT="$2"

  if [ "$E2E_PGBENCH_WRITE_WEIGHT" -gt 0 ]
  then
    printf '%s\n' "--file=$WRITE_SCRIPT@$(( 100 * E2E_PGBENCH_WRITE_WEIGHT ))"
  fi
  if [ "$E2E_PGBENCH_READ_WEIGHT" -gt 0 ]
  then
    printf '%s\n' "--file=$READ_SCRIPT@$(( 100 * E2E_PGBENCH_READ_WEIGHT ))"
  fi
}

# Share of the transactions of the benchmark that are read-only, as a percentage
pgbench_read_share() {
  printf %s "$(( E2E_PGBENCH_READ_WEIGHT * 100
    / (E2E_PGBENCH_READ_WEIGHT + E2E_PGBENCH_WRITE_WEIGHT) ))"
}

# Options shared by every pgbench runbook. log_checkpoints makes Postgres report
# the statistics of each checkpoint that pgbench triggers.
pgbench_cluster_options() {
  cat << EOF
--set-string
instanceProfiles[0].name=size-s
--set-string
instanceProfiles[0].cpu=500m
--set-string
instanceProfiles[0].memory=2Gi
--set
nonProductionOptions.disablePatroniResourceRequirements=false
--set
nonProductionOptions.disableClusterResourceRequirements=true
--set-string
configurations.postgresconfig.postgresql\.conf.max_connections=$E2E_PGBENCH_MAX_CONNECTIONS
--set-string
configurations.postgresconfig.postgresql\.conf.log_checkpoints=on
--set-string
configurations.poolingconfig.pgBouncer.pgbouncer\.ini.default_pool_size=$E2E_PGBENCH_DEFAULT_POOL_SIZE
--set-string
cluster.autoscaling.mode=none
EOF
  pgbench_disk_size_options
  pgbench_disk_performance_options
}

# Size the Postgres data volumes. Both the SGCluster and the coordinator of a
# SGShardedCluster are set by cluster.pods while its workers require
# shardedCluster.workers.pods, the unused one is simply ignored by the chart.
pgbench_disk_size_options() {
  cat << EOF
--set-string
cluster.pods.persistentVolume.size=$E2E_PGBENCH_DISK_SIZE
--set-string
shardedCluster.workers.pods.persistentVolume.size=$E2E_PGBENCH_DISK_SIZE
EOF
}

# Set the volume attributes class of the Postgres data volumes to the one created by
# pgbench_init_disk_performance.
pgbench_disk_performance_options() {
  if [ -z "$DISK_PERFORMANCE_VOLUME_ATTRIBUTES_CLASSNAME" ]
  then
    return
  fi

  cat << EOF
--set-string
cluster.pods.persistentVolume.volumeAttributesClassName=$DISK_PERFORMANCE_VOLUME_ATTRIBUTES_CLASSNAME
--set-string
shardedCluster.workers.pods.persistentVolume.volumeAttributesClassName=$DISK_PERFORMANCE_VOLUME_ATTRIBUTES_CLASSNAME
EOF
}

# Declare the custom container used to measure the disk performance of a cluster.
# The first parameter is the path of the pods section to set (`cluster.pods` for a
# SGCluster or for the coordinator of a SGShardedCluster) and the second one the
# name of the volume holding the Postgres data directory of that cluster.
pgbench_disk_benchmark_options() {
  local PODS_PATH="$1"
  local DATA_VOLUME_NAME="$2"

  if [ "$E2E_PGBENCH_DISK_BENCHMARK" != true ]
  then
    return
  fi

  cat << EOF
--set-string
$PODS_PATH.customContainers[0].name=$PGBENCH_DISK_BENCHMARK_CONTAINER
--set-string
$PODS_PATH.customContainers[0].image=$E2E_PGBENCH_DISK_BENCHMARK_IMAGE
--set-string
$PODS_PATH.customContainers[0].imagePullPolicy=IfNotPresent
--set-string
$PODS_PATH.customContainers[0].command[0]=/bin/sleep
--set-string
$PODS_PATH.customContainers[0].command[1]=infinity
--set-string
$PODS_PATH.customContainers[0].volumeMounts[0].name=$DATA_VOLUME_NAME
--set-string
$PODS_PATH.customContainers[0].volumeMounts[0].mountPath=$PGBENCH_DISK_BENCHMARK_MOUNT_PATH
EOF
}

# Same as pgbench_disk_benchmark_options but for the shards of a SGShardedCluster.
# Each shard is a distinct SGCluster with its own data volume, so a per shard
# override is required in order to mount the correct volume.
pgbench_shards_disk_benchmark_options() {
  local SHARDS="$1"
  local INDEX=0

  if [ "$E2E_PGBENCH_DISK_BENCHMARK" != true ]
  then
    return
  fi

  while [ "$INDEX" -lt "$SHARDS" ]
  do
    cat << EOF
--set
shardedCluster.workers.overrides[$INDEX].index=$INDEX
EOF
    pgbench_disk_benchmark_options \
      "shardedCluster.workers.overrides[$INDEX].pods" \
      "$CLUSTER_NAME-worker$INDEX-data"
    INDEX="$((INDEX + 1))"
  done
}

pgbench_create_cluster() {
  local INSTANCES="$1"
  shift

  # shellcheck disable=SC2046
  create_or_replace_cluster "$CLUSTER_NAME" "$CLUSTER_NAMESPACE" "$INSTANCES" \
    $(pgbench_cluster_options) \
    $(pgbench_disk_benchmark_options cluster.pods "$CLUSTER_NAME-data") \
    "$@"
}

pgbench_init_cluster() {
  local PODS="$1"

  deploy_psql_pod "$CLUSTER_NAMESPACE"

  wait_pods_running "$CLUSTER_NAMESPACE" "$PODS"
  wait_cluster "$CLUSTER_NAME" "$CLUSTER_NAMESPACE"

  pgbench_read_password

  kubectl exec -n "$CLUSTER_NAMESPACE" psql -q \
    -- env PGPASSWORD="$PGPASSWORD" pgbench -i -h "$CLUSTER_NAME" -s "$E2E_PGBENCH_SCALE"
}

pgbench_read_password() {
  PGPASSWORD="$(kubectl get secret -n "$CLUSTER_NAMESPACE" "$CLUSTER_NAME" \
    --template '{{ (index .data "superuser-password") | base64decode }}')"
}

pgbench_wait_service() {
  local HOST="$1"

  wait_until kubectl exec -n "$CLUSTER_NAMESPACE" psql -q \
    -- env PGPASSWORD="$PGPASSWORD" psql -q -h "$HOST" -c 'SELECT 1'
}

# Benchmark the cluster once per load step, from the lightest to the heaviest.
# The first parameter is the prefix of the log of each run, the remaining ones
# are passed to pgbench as they are.
pgbench_run_load_steps() {
  local BENCH_LOG="$1"
  shift
  local STEP

  for STEP in $(pgbench_load_steps)
  do
    pgbench_start_load_step "$BENCH_LOG" "$STEP" "$@"
    pgbench_wait_completion
  done
}

# Start a single load step. Kept apart from pgbench_run_load_steps so that a
# runbook may assert on what happens to the cluster while the step runs.
pgbench_start_load_step() {
  local BENCH_LOG="$1"
  local STEP="$2"
  shift 2

  PGBENCH_STEP="$STEP"
  PGBENCH_CLIENTS="$(( E2E_PGBENCH_CLIENTS * STEP / 100 ))"
  [ "$PGBENCH_CLIENTS" -ge 1 ] || PGBENCH_CLIENTS=1
  PGBENCH_JOBS="$(( E2E_PGBENCH_JOBS * STEP / 100 ))"
  [ "$PGBENCH_JOBS" -ge 1 ] || PGBENCH_JOBS=1
  [ "$PGBENCH_JOBS" -le "$PGBENCH_CLIENTS" ] || PGBENCH_JOBS="$PGBENCH_CLIENTS"

  echo "Benchmarking at $STEP% of the base load ($PGBENCH_CLIENTS clients, $PGBENCH_JOBS jobs)"

  pgbench_start "$BENCH_LOG-$STEP" "$@"
}

pgbench_start() {
  local DURATION
  local AGGREGATE_INTERVAL
  PGBENCH_LOG="$1"
  shift

  PGBENCH_STEP="${PGBENCH_STEP:-100}"
  PGBENCH_CLIENTS="${PGBENCH_CLIENTS:-$E2E_PGBENCH_CLIENTS}"
  PGBENCH_JOBS="${PGBENCH_JOBS:-$E2E_PGBENCH_JOBS}"
  DURATION="$(pgbench_duration)"
  AGGREGATE_INTERVAL="$((DURATION / 10))"
  [ "$AGGREGATE_INTERVAL" -ge 1 ] || AGGREGATE_INTERVAL=1

  # Checkpoint statistics are only extracted from the logs written since the
  # first benchmark started, that is also where the report of the runs starts
  if [ -z "$PGBENCH_LOGS_SINCE" ]
  then
    PGBENCH_LOGS_SINCE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    : > "$LOG_PATH/bench-runs"
    : > "$LOG_PATH/iostat-runs"
    : > "$LOG_PATH/checkpoint-runs"
  fi
  # A runbook may restart a run under the same log, only report it once
  if ! grep -q "^$PGBENCH_LOG " "$LOG_PATH/bench-runs" 2>/dev/null
  then
    echo "$PGBENCH_LOG $PGBENCH_STEP $PGBENCH_CLIENTS $PGBENCH_JOBS" >> "$LOG_PATH/bench-runs"
    # When the run started, in the very same format and timezone Postgres
    # timestamps its log with, so that each checkpoint can be told apart by the
    # run it belongs to. A run lasts until the next one starts, a restart of the
    # run keeps the instant its first attempt started at.
    echo "$PGBENCH_LOG $(date -u '+%Y-%m-%d %H:%M:%S')" >> "$LOG_PATH/checkpoint-runs"
  fi

  kubectl exec -n "$CLUSTER_NAMESPACE" psql -q \
    -- env PGPASSWORD="$PGPASSWORD" pgbench \
      -T "$DURATION" \
      -C -c "$PGBENCH_CLIENTS" -j "$PGBENCH_JOBS" \
      --progress=5 \
      --log --log-prefix=/tmp/pgbench_log \
      --failures-detailed \
      --aggregate-interval="$AGGREGATE_INTERVAL" \
      "$@" 2>&1 | tee "$LOG_PATH/$PGBENCH_LOG" &
  PGBENCH_PID="$!"
  trap_kill "$PGBENCH_PID"

  pgbench_start_iostat
}

pgbench_running() {
  kill -0 "$PGBENCH_PID" 2>/dev/null
}

pgbench_stop() {
  pgbench_stop_iostat
  kill "$PGBENCH_PID" || true
  kubectl exec -n "$CLUSTER_NAMESPACE" psql -q \
    -- bash -c 'ps -ef | grep "[p]gbench" | tr -s " " | cut -d " " -f 2 | while read PID; do kill "$PID"; done' || true
}

pgbench_collect_transactions() {
  kubectl exec -n "$CLUSTER_NAMESPACE" psql -q -- bash -c 'cat /tmp/pgbench_log*' \
    > "$LOG_PATH/$PGBENCH_LOG-transactions"
  kubectl exec -n "$CLUSTER_NAMESPACE" psql -q -- bash -c 'rm -f /tmp/pgbench_log*' || true
}

pgbench_wait_completion() {
  if wait_until eval '! kill -0 "$PGBENCH_PID"' \
    && ! grep -q '^command terminated with exit code [1-9]' "$LOG_PATH/$PGBENCH_LOG"
  then
    echo "success Benchmark terminated succesfully"
  else
    echo "FAIL: Benchmark not terminated succesfully"
    pgbench_stop
    return 1
  fi
  pgbench_stop
  pgbench_collect_transactions
  pgbench_collect_checkpoint_stats
}

# Pods running the custom container used to measure the disk performance
pgbench_disk_benchmark_pods() {
  kubectl get pod -n "$CLUSTER_NAMESPACE" -o json \
    | jq -r --arg container "$PGBENCH_DISK_BENCHMARK_CONTAINER_NAME" \
      '.items[]|select(.spec.containers|any(.name == $container))|.metadata.name'
}

pgbench_exec_disk_benchmark() {
  local POD="$1"
  shift

  kubectl exec -n "$CLUSTER_NAMESPACE" "$POD" \
    -c "$PGBENCH_DISK_BENCHMARK_CONTAINER_NAME" -- "$@"
}

# Measure what the disk backing the Postgres data volume of each cluster Pod is
# able to deliver. Must be called before any benchmark is started so that fio
# neither perturbs the benchmark nor is perturbed by it.
pgbench_collect_disk_performance() {
  local POD

  rm -f "$LOG_PATH/disk-performance-pods"

  if [ "$E2E_PGBENCH_DISK_BENCHMARK" != true ]
  then
    echo "Skipping disk performance collection since E2E_PGBENCH_DISK_BENCHMARK is not true"
    return
  fi

  for POD in $(pgbench_disk_benchmark_pods)
  do
    echo "Collecting disk performance of Pod $POD"
    pgbench_collect_disk_usage "$POD"
    # shellcheck disable=SC2046
    pgbench_collect_fio "$POD" sync $(pgbench_fio_sync_jobs)
    # shellcheck disable=SC2046
    pgbench_collect_fio "$POD" deep $(pgbench_fio_deep_jobs)
    echo "$POD" >> "$LOG_PATH/disk-performance-pods"
  done

  if [ ! -s "$LOG_PATH/disk-performance-pods" ]
  then
    echo "WARNING: no Pod is running the $PGBENCH_DISK_BENCHMARK_CONTAINER_NAME container"
  fi
}

pgbench_collect_disk_usage() {
  local POD="$1"

  pgbench_exec_disk_benchmark "$POD" df -h "$PGBENCH_DISK_BENCHMARK_MOUNT_PATH" \
    > "$LOG_PATH/df-$POD" 2>&1 || true
}

# Sample the devices of each cluster Pod while the benchmark runs. iostat is left
# running in background and stopped by pgbench_stop, the number of samples is
# bounded so that it also terminates on its own if that stop never happens.
pgbench_start_iostat() {
  local POD
  local COUNT

  PGBENCH_IOSTAT_PIDS=

  if [ "$E2E_PGBENCH_DISK_BENCHMARK" != true ]
  then
    return
  fi

  COUNT="${E2E_PGBENCH_IOSTAT_COUNT:-$(( $(pgbench_duration) / E2E_PGBENCH_IOSTAT_INTERVAL + 2 ))}"

  for POD in $(pgbench_disk_benchmark_pods)
  do
    # -y omits the first report, that holds the averages since boot and would
    # otherwise dilute what the benchmark itself is doing to the disk. LC_ALL
    # keeps the decimal separator a dot, whatever locale the image defaults to.
    pgbench_exec_disk_benchmark "$POD" \
      sh -c 'LC_ALL=C exec iostat -x -m -y "$1" "$2"' _ \
      "$E2E_PGBENCH_IOSTAT_INTERVAL" "$COUNT" \
      > "$LOG_PATH/iostat-$PGBENCH_LOG-$POD" 2>&1 &
    PGBENCH_IOSTAT_PIDS="$PGBENCH_IOSTAT_PIDS $!"
    trap_kill "$!"
    if ! grep -q "^$POD $PGBENCH_LOG\$" "$LOG_PATH/iostat-runs" 2>/dev/null
    then
      echo "$POD $PGBENCH_LOG" >> "$LOG_PATH/iostat-runs"
    fi
  done
}

pgbench_stop_iostat() {
  local PID

  for PID in $PGBENCH_IOSTAT_PIDS
  do
    kill "$PID" 2>/dev/null || true
  done
  PGBENCH_IOSTAT_PIDS=
}

# Jobs issuing a single synchronous request at a time. A queue that shallow can
# never reach the IOPS a volume is provisioned for, what they measure is the
# latency of the disk and, for the sequential job, its throughput ceiling.
# rand-rw mixes reads and writes in a single job, the way a Postgres backend
# actually uses the disk, while the other random jobs isolate each direction.
pgbench_fio_sync_jobs() {
  cat << EOF
--ioengine=psync
--name=seq-write
--rw=write
--bs=1m
--name=rand-read
--rw=randread
--bs=8k
--stonewall
--name=rand-write
--rw=randwrite
--bs=8k
--stonewall
--name=rand-rw
--rw=randrw
--rwmixread=$E2E_PGBENCH_FIO_RWMIXREAD
--bs=8k
--stonewall
--name=wal-fsync
--rw=write
--bs=8k
--fdatasync=1
--direct=0
--stonewall
EOF
}

# Jobs keeping E2E_PGBENCH_FIO_IODEPTH requests in flight, enough to saturate the
# disk and so to tell whether it really delivers the IOPS it is provisioned for.
pgbench_fio_deep_jobs() {
  cat << EOF
--ioengine=$E2E_PGBENCH_FIO_IOENGINE
--iodepth=$E2E_PGBENCH_FIO_IODEPTH
--name=rand-read-deep
--rw=randread
--bs=8k
--name=rand-write-deep
--rw=randwrite
--bs=8k
--stonewall
--name=rand-rw-deep
--rw=randrw
--rwmixread=$E2E_PGBENCH_FIO_RWMIXREAD
--bs=8k
--stonewall
EOF
}

# Run a fio profile. Each profile is collected on its own so that one of them
# failing, the deep queue jobs requiring an asynchronous I/O engine that the
# image may not provide, still leaves the other one reported.
pgbench_collect_fio() {
  local RESULT
  local EXIT_CODE
  local POD="$1"
  local PROFILE="$2"
  shift 2

  # Direct I/O is not available on every filesystem a PersistentVolume may use,
  # fallback to buffered I/O when it is not supported.
  try_function pgbench_run_fio "$POD" "$PROFILE" 1 "$@"
  if "$RESULT"
  then
    return
  fi
  echo "fio $PROFILE profile failed using direct I/O on Pod $POD, retrying using buffered I/O"
  try_function pgbench_run_fio "$POD" "$PROFILE" 0 "$@"
  if "$RESULT"
  then
    return
  fi
  echo "WARNING: unable to collect the fio $PROFILE profile of Pod $POD"
  cat "$LOG_PATH/fio-$PROFILE-$POD.err" || true
  rm -f "$LOG_PATH/fio-$PROFILE-$POD.json" "$LOG_PATH/fio-$PROFILE-$POD.direct"
}

pgbench_run_fio() {
  local POD="$1"
  local PROFILE="$2"
  local DIRECT="$3"
  shift 3

  # Whether the numbers were measured against the disk or against the page cache
  # changes how they must be read, keep track of it for the report
  echo "$DIRECT" > "$LOG_PATH/fio-$PROFILE-$POD.direct"

  pgbench_exec_disk_benchmark "$POD" sh -ec '
    DIRECTORY="$1"
    SIZE="$2"
    RUNTIME="$3"
    DIRECT="$4"
    shift 4
    mkdir -p "$DIRECTORY"
    trap "rm -rf \"$DIRECTORY\"" EXIT
    fio --output-format=json \
      --directory="$DIRECTORY" \
      --direct="$DIRECT" --unlink=1 \
      --time_based --ramp_time=1 --runtime="$RUNTIME" --size="$SIZE" \
      --group_reporting=1 \
      "$@"
    ' _ "$PGBENCH_DISK_BENCHMARK_PATH" "$E2E_PGBENCH_FIO_SIZE" "$E2E_PGBENCH_FIO_RUNTIME" \
      "$DIRECT" "$@" \
    > "$LOG_PATH/fio-$PROFILE-$POD.json" 2> "$LOG_PATH/fio-$PROFILE-$POD.err"
}

# Extract the checkpoint statistics Postgres logged during the benchmark. Replicas
# log restartpoints instead of checkpoints, both are collected. Everything logged
# since the first benchmark started is collected on every call, the report then
# groups it by the run each checkpoint was started in.
#
# How the numbers of a `checkpoint complete:` line are to be read (see
# LogCheckpointEnd in src/backend/access/transam/xlog.c and ProcessSyncRequests
# in src/backend/storage/sync/sync.c of the Postgres sources):
#
# * write= is the wall clock of the phase writing the dirty buffers out. Postgres
#   deliberately spreads those writes over checkpoint_completion_target of the
#   interval, so a write time close to checkpoint_timeout is what a healthy
#   checkpoint looks like and says nothing about how fast the disk is.
# * sync= is the wall clock of the phase fsync'ing the files those writes went to,
#   taken around the whole ProcessSyncRequests call. It is not the sum of the
#   fsync calls: scanning the pending operations, absorbing the requests the
#   backends queue in the meanwhile and opening the segments that are not open
#   yet are all measured by it too.
# * sync files= is the number of fsync calls that succeeded, that is of file
#   segments (of up to 1 GB each, plus the pg_xact, pg_commit_ts and pg_multixact
#   ones), not of relations.
# * longest= and average= are the only per fsync numbers of the line. Postgres
#   times every single fsync call and reports the longest of them and their mean,
#   the mean being the sum of those timings divided by sync files. Dividing sync=
#   by sync files= is therefore wrong, it charges the overhead of the whole phase
#   to the fsync calls and overestimates what a single one costs, which is why the
#   fsync columns of the report are taken from average= and longest= instead.
# * Both of them are rounded up to whole milliseconds before being logged, the
#   source computing them as (microseconds + 999) / 1000, so every fsync faster
#   than a millisecond is logged as 0.001 s. On a fast disk the fsync columns are
#   consequently a ceiling and not a measurement: the f_await column of the iostat
#   table and the wal-fsync job of the fio table are what resolves them.
pgbench_collect_checkpoint_stats() {
  local POD

  rm -f "$LOG_PATH/checkpoint-pods"

  for POD in $(kubectl get pod -n "$CLUSTER_NAMESPACE" -l app=StackGresCluster \
    -o name | cut -d / -f 2)
  do
    kubectl logs -n "$CLUSTER_NAMESPACE" "$POD" -c patroni \
      ${PGBENCH_LOGS_SINCE:+--since-time="$PGBENCH_LOGS_SINCE"} 2>/dev/null \
      | grep -E '(checkpoint|restartpoint) (starting|complete):' \
      > "$LOG_PATH/checkpoints-$POD" || true
    echo "$POD" >> "$LOG_PATH/checkpoint-pods"
  done
}

pgbench_print_section() {
  echo
  echo "$PGBENCH_RULE"
  echo " $1"
  echo "$PGBENCH_RULE"
}

pgbench_print_subsection() {
