  printf '   %-26s %s\n' 'scale factor' \
    "$E2E_PGBENCH_SCALE (dataset of roughly $(( E2E_PGBENCH_SCALE * 15 )) MiB)"
  printf '   %-26s %s\n' 'read / write weights' \
    "$E2E_PGBENCH_READ_WEIGHT / $E2E_PGBENCH_WRITE_WEIGHT ($(pgbench_read_share)% read-only transactions)"
  printf '   %-26s %s\n' 'base clients / jobs' "$E2E_PGBENCH_CLIENTS / $E2E_PGBENCH_JOBS"
  printf '   %-26s %s\n' 'load steps' "$STEPS"
  printf '   %-26s %s\n' 'duration per run' "$(pgbench_duration) s"
  printf '   %-26s %s\n' 'data volume size' "$E2E_PGBENCH_DISK_SIZE"
  printf '   %-26s %s\n' 'provisioned IOPS' \
    "${E2E_PGBENCH_DISK_IOPS:-<environment default>}"
  printf '   %-26s %s\n' 'provisioned throughput' "$THROUGHPUT"
  printf '   %-26s %s\n' 'pgbouncer pool size' "$E2E_PGBENCH_DEFAULT_POOL_SIZE"
  printf '   %-26s %s\n' 'postgres max_connections' "$E2E_PGBENCH_MAX_CONNECTIONS"
