  echo " $1"
  echo " ${PGBENCH_SUBRULE}"
}

pgbench_print_configuration() {
  local STEP
  local STEPS=
  local THROUGHPUT='<environment default>'

  for STEP in $(pgbench_load_steps)
  do
    STEPS="$STEPS${STEPS:+, }$STEP% ($(( E2E_PGBENCH_CLIENTS * STEP / 100 )) clients)"
  done
  if [ -n "$E2E_PGBENCH_DISK_THROUGHPUT" ]
