#!/bin/sh

LOCK_DURATION="${LOCK_DURATION:-60}"
LOCK_SLEEP="${LOCK_SLEEP:-${LOCK_POLL_INTERVAL:-5}}"
LOCK_GET_RETRIES="${LOCK_GET_RETRIES:-5}"
LOCK_GET_RETRY_DELAY="${LOCK_GET_RETRY_DELAY:-2}"
QUEUE_NAME=create_event.pipe
RETRY_DELAY="${RETRY_DELAY:-1000}"
RETRY_LIMIT="${RETRY_LIMIT:-10}"
RETRY_MAX_DELAY="${RETRY_MAX_DELAY:-60000}"

SHELL="$(readlink /proc/$$/exe || true)"
if ! command -v "$SHELL" >/dev/null 2>&1 \
  || [ "x$(basename "$SHELL")" = x ] \
  || [ "x$(basename "$SHELL")" = xbusybox ]
then
  SHELL=sh
fi
SHELL_XTRACE=$(! echo $- | grep -q x || echo " -x")

acquire_lock() {
  try_lock true
}

# Renews the lease every LOCK_SLEEP seconds. A renewal failure is only fatal when the
# lease has been confirmed taken over by another holder or has expired (try_lock returns
# 2); a transient failure to reach the API server (try_lock returns 1) must NOT be
# mistaken for a lost lock while the lease is still validly held: it is tolerated and
# retried until either the renewal succeeds again or the lease can no longer possibly be
# held by us, i.e. LOCK_DURATION seconds elapse without a successful renewal. This mirrors
# the renew deadline of Kubernetes lease based leader election and prevents a momentary
# API hiccup from aborting a long running operation (e.g. a major version upgrade) that
# still safely holds the lock.
maintain_lock() {
  local LAST_RENEW ATTEMPT RC
  LAST_RENEW="$(date +%s)"
  while true
  do
    sleep "$LOCK_SLEEP"
    # Captured before the renewal so that, on success, the deadline is computed from a
    # time no later than the renewTime actually written: we always give up at or before
    # the lease really expires, never after, so two holders can not overlap.
    ATTEMPT="$(date +%s)"
    # The exit code is captured with `|| RC=$?` so that a non-zero renewal result does
    # not abort the loop under `set -e` (run-dbops.sh runs maintain_lock with set -e):
    # whether a failure is fatal is decided below from RC, not by set -e.
    RC=0
    try_lock false || RC="$?"
    case "$RC" in
      (0)
      LAST_RENEW="$ATTEMPT"
      ;;
      (2)
      return 1
      ;;
      (*)
      if [ "$(( $(date +%s) - LAST_RENEW ))" -ge "$LOCK_DURATION" ]
      then
        echo "Could not renew lease $LOCK_LEASE_NAME within $LOCK_DURATION seconds, giving up the lock"
        return 1
      fi
      ;;
    esac
  done
}

# Reads the Lease into /tmp/lock-lease using the provided go-template.
# A transient failure to reach the API server (e.g. a momentary 401/Unauthorized
# or connection error under load) must NOT be mistaken for a lost lock, so the
# read is retried LOCK_GET_RETRIES times (waiting LOCK_GET_RETRY_DELAY seconds in
# between, which stays well within LOCK_DURATION) before giving up. The previous
# CAS-based lock tolerated these failures implicitly; the Lease lock must do so
# explicitly. Returns non-zero only when the Lease can not be read after retries.
get_lease() {
  local ATTEMPT=0
  until "$KUBECTL_BIN_PATH" get lease -n "$LOCK_LEASE_NAMESPACE" "$LOCK_LEASE_NAME" \
    --template="$1" > /tmp/lock-lease 2>/tmp/lock-lease.err
  do
    cat /tmp/lock-lease.err
    ATTEMPT="$((ATTEMPT + 1))"
    if [ "$ATTEMPT" -ge "$LOCK_GET_RETRIES" ]
    then
      return 1
    fi
    sleep "$LOCK_GET_RETRY_DELAY"
  done
}

# Lock implementation backed by a coordination.k8s.io/v1 Lease.
# Required env vars:
#   LOCK_LEASE_NAMESPACE  - namespace holding the Lease (typically the cluster namespace)
#   LOCK_LEASE_NAME       - Lease name (sgcluster-NAME, sgshardedcluster-NAME, sgstream-NAME)
#   SERVICE_ACCOUNT       - service account of the worker pod
#   POD_NAME              - worker pod name
#   LOCK_DURATION         - lease duration in seconds
#   LOCK_SLEEP            - renewal interval in seconds (defaults to LOCK_POLL_INTERVAL)
#   LOCK_GET_RETRIES      - times to retry reading the Lease on transient API errors
#   LOCK_GET_RETRY_DELAY  - seconds to wait between Lease read retries
try_lock() {
  if [ -z "$LOCK_LEASE_NAMESPACE" ] || [ -z "$LOCK_LEASE_NAME" ] \
    || [ -z "$POD_NAME" ] || [ -z "$SERVICE_ACCOUNT" ]
  then
    echo "LOCK_LEASE_NAMESPACE, LOCK_LEASE_NAME, SERVICE_ACCOUNT and POD_NAME environment variables must be defined"
    return 1
  fi
  local AQUIRE="$1"
  local HOLDER_ME="$SERVICE_ACCOUNT/$POD_NAME"
  local TEMPLATE='
  HOLDER_IDENTITY={{ with .spec.holderIdentity }}{{ . }}{{ end }}
  RENEW_TIME={{ with .spec.renewTime }}{{ . }}{{ end }}
  LEASE_DURATION_SECONDS={{ with .spec.leaseDurationSeconds }}{{ . }}{{ else }}0{{ end }}
  LEASE_TRANSITIONS={{ with .spec.leaseTransitions }}{{ . }}{{ else }}0{{ end }}
  RESOURCE_VERSION={{ .metadata.resourceVersion }}
  '
  if ! get_lease "$TEMPLATE"
  then
    return 1
  fi
  . /tmp/lock-lease
  CURRENT_TIMESTAMP="$(date +%s)"
  EXPIRY_TIMESTAMP=0
  if [ -n "$RENEW_TIME" ]
  then
    EXPIRY_TIMESTAMP="$(($(date -d "$RENEW_TIME" +%s) + LEASE_DURATION_SECONDS))"
  fi
  if [ "$HOLDER_ME" != "$HOLDER_IDENTITY" ]
  then
    if "$AQUIRE"
    then
      if [ "$CURRENT_TIMESTAMP" -lt "$EXPIRY_TIMESTAMP" ]
      then
        local WAIT_DURATION="$((LOCK_DURATION + LOCK_SLEEP))"
        echo "Lease already held by $HOLDER_IDENTITY until $(date -d @"$EXPIRY_TIMESTAMP" -Iseconds --utc), will retry in $WAIT_DURATION seconds"
        sleep "$WAIT_DURATION"
        try_lock true
        return $?
      fi
    else
      # Confirmed loss: the lease is held by another identity (return 2 so maintain_lock
      # gives up the lock immediately instead of treating it as a transient failure).
      echo "Lease already held by $HOLDER_IDENTITY until $(date -d @"$EXPIRY_TIMESTAMP" -Iseconds --utc)"
      return 2
    fi
  else
    if ! "$AQUIRE" && [ "$CURRENT_TIMESTAMP" -gt "$EXPIRY_TIMESTAMP" ]
    then
      # Confirmed loss: our own lease has expired (return 2, see above).
      echo "Lease expired!"
      return 2
    fi
  fi
  local NOW_RFC3339
  NOW_RFC3339="$(date -u +%Y-%m-%dT%H:%M:%S.%6NZ)"
  local NEW_TRANSITIONS="$LEASE_TRANSITIONS"
  # The resourceVersion is set in the patch body (not as a CLI flag, which does
  # not exist) so the API server enforces optimistic concurrency and rejects the
  # patch with a Conflict if the Lease was modified since we read it.
  local PATCH='{"metadata":{"resourceVersion":"'"$RESOURCE_VERSION"'"},"spec":{"holderIdentity":"'"$HOLDER_ME"'","leaseDurationSeconds":'"$LOCK_DURATION"',"renewTime":"'"$NOW_RFC3339"'"'
  if [ "$HOLDER_ME" != "$HOLDER_IDENTITY" ]
  then
    NEW_TRANSITIONS="$((LEASE_TRANSITIONS + 1))"
    PATCH="$PATCH"',"acquireTime":"'"$NOW_RFC3339"'","leaseTransitions":'"$NEW_TRANSITIONS"
  fi
  PATCH="$PATCH"'}}'
  if ! "$KUBECTL_BIN_PATH" patch lease -n "$LOCK_LEASE_NAMESPACE" "$LOCK_LEASE_NAME" \
    --type merge -p "$PATCH"
  then
    # Refetch the lease; if we still hold it the patch failure was a transient
    # CAS conflict and we retry. Otherwise the lock has been taken by someone else.
    if ! get_lease "$TEMPLATE"
    then
      return 1
    fi
    . /tmp/lock-lease
    if [ "$HOLDER_ME" = "$HOLDER_IDENTITY" ]
    then
      try_lock "$AQUIRE"
      return $?
    fi
    echo "Lease held by $HOLDER_IDENTITY"
    if "$AQUIRE"
    then
      sleep "$((LOCK_SLEEP * 4))"
      try_lock true
      return $?
    fi
    # Confirmed loss: the lease was taken over by another holder while we renewed.
    return 2
  fi
}

release_lock() {
  if [ -z "$LOCK_LEASE_NAMESPACE" ] || [ -z "$LOCK_LEASE_NAME" ] \
    || [ -z "$POD_NAME" ] || [ -z "$SERVICE_ACCOUNT" ]
  then
    echo "LOCK_LEASE_NAMESPACE, LOCK_LEASE_NAME, SERVICE_ACCOUNT and POD_NAME environment variables must be defined"
    return 1
  fi
  local HOLDER_ME="$SERVICE_ACCOUNT/$POD_NAME"
  local TEMPLATE='
  HOLDER_IDENTITY={{ with .spec.holderIdentity }}{{ . }}{{ end }}
  RESOURCE_VERSION={{ .metadata.resourceVersion }}
  '
  if ! get_lease "$TEMPLATE"
  then
    return 0
  fi
  . /tmp/lock-lease
  if [ "$HOLDER_ME" != "$HOLDER_IDENTITY" ]
  then
    return 0
  fi
  local PATCH='{"metadata":{"resourceVersion":"'"$RESOURCE_VERSION"'"},"spec":{"holderIdentity":null,"renewTime":null,"leaseDurationSeconds":null}}'
  if ! "$KUBECTL_BIN_PATH" patch lease -n "$LOCK_LEASE_NAMESPACE" "$LOCK_LEASE_NAME" \
    --type merge -p "$PATCH"
  then
    release_lock
    return 0
  fi
}

to_json_string() {
  jq -s -R .
}

date_iso8601() {
  date +%Y-%m-%dT%H:%M:%SZ --utc
}

create_event() {
  create_event_try "$@" || true
}

create_event_try() {
  local REASON="$1"
  local TYPE="$2"
  local MESSAGE="$3"
  local EVENT_ID="$(get_event_id)"
  local EVENT_NAME="$RESOURCE_NAME.$EVENT_ID"
  local EVENT_TIMESTAMP="$(date_iso8601)"
  local COMPONENT="$OP_NAME"
  local RESULT

  echo "Creating event with reason '$REASON' of type '$TYPE' with message '$MESSAGE'"
  RESULT="$({ "$KUBECTL_BIN_PATH" get "$RESOURCE_CRD_NAME" -n "$CLUSTER_NAMESPACE" "$RESOURCE_NAME" -o json || printf .; } | jq -c .)"
  MESSAGE="$(printf '%s' "$MESSAGE" | jq -s -R .)"
  RESULT="$(printf '%s' "$RESULT" | jq -c '{
      apiVersion: "v1",
      type: "'"$TYPE"'",
      reason: "'"$REASON"'",
      message: '"$MESSAGE"',
      metadata: {
        name: "'"$EVENT_NAME"'",
        namespace: "'"$CLUSTER_NAMESPACE"'",
        labels: .metadata.labels
      },
      count: 1,
      firstTimestamp: "'"$EVENT_TIMESTAMP"'",
      lastTimestamp: "'"$EVENT_TIMESTAMP"'",
      source: {
        component: "'"$COMPONENT"'"
      },
      involvedObject: {
        apiVersion: .apiVersion,
        kind: .kind,
        namespace: .metadata.namespace,
        name: .metadata.name,
        resourceVersion: .metadata.resourceVersion,
        uid: .metadata.uid
      }
    }')"
  printf '%s' "$RESULT" | "$KUBECTL_BIN_PATH" create --raw "/api/v1/namespaces/$CLUSTER_NAMESPACE/events" -f -
}

get_event_id() {
  local MILLIS_SINCE_EPOCH="$(date +%s%N | cut -b1-13)"
  local RANDOM_LONG="$(get_random_long)"
  local HEX_MILLIS="$(printf '%x\n' "$MILLIS_SINCE_EPOCH")"
  local HEX_RANDOM_LONG="$(printf '%x\n' "$RANDOM_LONG")"
  echo "$HEX_MILLIS$HEX_RANDOM_LONG"
}

get_random_long() {
  cat /dev/urandom | tr -dc '0-9' | head -c 15 | sed 's/^0\+//'
}

from_date_iso8601_to_unix_timestamp() {
  [ -n "$1" ]
  date -d "$1" +%s
}

is_child() {
  local PID="$1"
  grep -q "^PPid:[[:space:]]$$" "/proc/$PID/status" 2>/dev/null
}

kill_with_childs() {
  (
  [ "$DEBUG" = true ] || set +x
  set +e
  local PID="$1"
  local SPIDS="x"
  local OPIDS
  OPIDS="$PID"
  local OPPID="$OPIDS"
  while [ -n "$OPPID" ]
  do
      OPPID="$(grep '^PPid:[[:space:]]'"\($(
            echo "$OPPID" | sed '{s/ $//;s/ /\\|/g}'
          )\)"'$' /proc/[0-9]*/status 2>/dev/null \
        | cut -d / -f 3 | tr '\n' ' ')"
      OPIDS="$OPIDS $OPPID"
  done
  kill -13 $OPIDS 2>/dev/null || true
  )
}

kill_session_siblings() {
  (
  [ "$DEBUG" = true ] || set +x
  set +e
  local PID="$(exec "$SHELL" -c 'echo $PPID')"
  local NSUID="$(id -u)"
  local NSSID="$(grep '^NSsid:[[:space:]]' "/proc/$PID/status" \
        | tr -d '[:space:]' | cut -d : -f 2)"
  local SPIDS="x"
  local OPIDS
  OPIDS="$PID"
  local OPPID="$OPIDS"
  while [ "$OPPID" != "$NSSID" ]
  do
      OPPID="$(grep '^PPid:[[:space:]]' "/proc/$OPPID/status" \
        | tr -d '[:space:]' | cut -d : -f 2)"
      OPIDS="$OPIDS $OPPID"
  done
  while [ "$SPIDS" = x ] \
    || [ "$(ls -d $(echo "$SPIDS" | sed 's#\([0-9]\+\) #/proc/\1 #g') 2>&1 | grep -i 'no such' | wc -l)" \
      -lt "$(echo "$SPIDS" | wc -w)" ]
  do
    test "$SPIDS" = "x" || kill -13 $SPIDS 2>/dev/null || true
    SPIDS="$(grep '\(^Uid:[[:space:]]\+'"$NSUID"'[[:space:]]\|^NSsid:[[:space:]]'"$NSSID"'$\)' -c /proc/[0-9]*/status 2>/dev/null \
      | grep ':2$' | cut -d / -f 3 | grep -v '^'"\($(echo "$OPIDS" | sed 's/ /\\|/g')\)"'$' | tr '\n' ' ')"
  done
  ) || true
}

trap_callback() {
  kill_session_siblings
}

trap_callback_and_exit() {
  trap_callback
  exit "$1"
}

set_trap() {
  trap 'trap_callback_and_exit $?' HUP INT QUIT PIPE TERM ABRT
  trap 'trap_callback $?' EXIT
}

create_event_queue() {
  local PIPELINE_MODE="p"
  rm -f "$SHARED_PATH/$QUEUE_NAME" 
  mknod "$SHARED_PATH/$QUEUE_NAME" "$PIPELINE_MODE"
}

create_event_service() {
  echo "$1" "$2" "$(printf %s "$3" | base64 -w 0)" >> "$SHARED_PATH/$QUEUE_NAME"
}

read_events_service_loop() {
  while true
  do
    read_events_service
  done
}

read_events_service() {
  while read -r REASON TYPE MESSAGE
  do
    create_event "$REASON" "$TYPE" "$(printf %s "$MESSAGE" | base64 -d)"
  done < "$SHARED_PATH/$QUEUE_NAME"
}

try_function_with_output() {
  (
    set +e
    (
    { { { "$@" 2>&1; echo $? >&3; } | tee "$SHARED_PATH/output" >&4; }  3>&1 | { read EXIT_CODE; exit "$EXIT_CODE"; }; } 4>&1
    )
    printf %s "$?" > "$SHARED_PATH/exit_code"
  )
}

retry() {
  local RETRY=0
  local BACKOFF
  until "$@"
  do
    if retry_stop "$RETRY"
    then
      return 1
    fi
    BACKOFF="$(retry_backoff_delay "$RETRY")"
    >&2 echo "Will retry command after backoff of $BACKOFF seconds ($((RETRY_LIMIT - RETRY)) retry left)"
    sleep "$BACKOFF"
    RETRY="$((RETRY+1))"
  done      
}

retry_forever() {
  until "$@"
  do
    retry_backoff
  done
}

is_not_conflict() {
  local OUTPUT="$1"
  ! printf %s "$OUTPUT" | grep -q 'the object has been modified'
}

retry_backoff() {
  local RETRY="${1:-0}"
  sleep "$(retry_backoff_delay "$RETRY")"
}

retry_backoff_delay() {
  local RETRY="${1:-0}"
  printf %s "$(( (RETRY_DELAY << RETRY > RETRY_MAX_DELAY ? RETRY_MAX_DELAY : RETRY_DELAY << RETRY) / 1000 ))"
}

retry_stop() {
  local RETRY="${1:-0}"
  if [ "$RETRY" -ge "$RETRY_LIMIT" ]
  then
    >&2 echo "Failed $@ after retrying $RETRY_LIMIT times"
    return 0
  fi
  return 1
}
