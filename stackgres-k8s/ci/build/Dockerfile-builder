####
# This Dockerfile is used in order to build a container that runs the StackGres builds
#
# Build the image with:
#
# docker build -f stackgres-k8s/ci/build/Dockerfile-builder -t registry.gitlab.com/ongresinc/stackgres/build-amd64:1.7 stackgres-k8s/ci/build/
# #
# docker build --platform linux/amd64,linux/arm64 -f stackgres-k8s/ci/build/Dockerfile-builder -t "registry.gitlab.com/ongresinc/stackgres/$(yq -r '.variables.BUILDER_IMAGE_NAME' .gitlab-ci.yml)" stackgres-k8s/ci/build/
#
# or:
#
# docker build -f stackgres-k8s/ci/build/Dockerfile-builder -t "registry.gitlab.com/ongresinc/stackgres/$(yq -r '.variables.BUILDER_IMAGE_NAME' .gitlab-ci.yml)-$(uname -m | grep -qxF aarch64 && echo arm64 || echo amd64)" stackgres-k8s/ci/build/
#
#
###

FROM quay.io/quarkus/ubi-quarkus-mandrel-builder-image:jdk-25.0.4.1
  USER root
  RUN microdnf --nodocs install python3-pip jq util-linux findutils && microdnf clean all
  RUN pip3 install yamllint yq
